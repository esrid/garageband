package ui

// Sections of the application shell. A page names the one it belongs to so the
// navigation can mark it as current.
const (
	SectionDashboard = "dashboard"
	SectionLocations = "locations"
	SectionTeam = "team"
	SectionCustomers = "customers"
	SectionAgenda    = "agenda"
	SectionCalls     = "calls"
	SectionAgents    = "agents"
	SectionCatalog   = "catalog"
	SectionAssistant = "assistant"
)

// Nav describes the application shell around a page. Its zero value renders no
// chrome at all, which is what the signed-out and onboarding screens want.
//
// Every field is something the page already knows, so the shell costs no extra
// query: Section is a constant, and Workspace is the active workspace name the
// page is displaying anyway.
type Nav struct {
	Section   string // one of the Section* constants; empty hides the shell
	Workspace string // active workspace name, shown when known
	// InWorkspace gates workspace-scoped links. It is separate from Workspace
	// because a detail screen can know it is inside a workspace without
	// knowing its name.
	InWorkspace bool
}

func (n Nav) visible() bool { return n.Section != "" }

// current is the aria-current value for a section. "false" is the ARIA-defined
// way to say "not the current page".
func (n Nav) current(section string) string {
	if n.Section == section {
		return "page"
	}
	return "false"
}

// PageInfo carries everything a page can tell the layout about itself,
// including the SEO surface. Zero-value fields render nothing: only Title is
// required.
type PageInfo struct {
	Title       string // <title> and og:title
	Description string // meta description and og:description
	Canonical   string // absolute canonical URL; also og:url
	Image       string // absolute image URL for social cards (og:image)
	Type        string // og:type; empty means "website"
	NoIndex     bool   // ask crawlers to skip this page (login, admin…)
	Nav         Nav    // application shell; zero value renders none
}

func (p PageInfo) ogType() string {
	if p.Type == "" {
		return "website"
	}
	return p.Type
}

// Layout is the shared page shell. Features wrap their content in it:
//
//	@ui.Layout(ui.PageInfo{Title: "Dashboard"}) { ...content... }
templ Layout(page PageInfo) {
	<!DOCTYPE html>
	<html lang="fr">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ page.Title }</title>
			if page.Description != "" {
				<meta name="description" content={ page.Description }/>
			}
			if page.NoIndex {
				<meta name="robots" content="noindex, nofollow"/>
			}
			if page.Canonical != "" {
				<link rel="canonical" href={ templ.URL(page.Canonical) }/>
			}
			<meta property="og:title" content={ page.Title }/>
			if page.Description != "" {
				<meta property="og:description" content={ page.Description }/>
			}
			<meta property="og:type" content={ page.ogType() }/>
			if page.Canonical != "" {
				<meta property="og:url" content={ page.Canonical }/>
			}
			if page.Image != "" {
				<meta property="og:image" content={ page.Image }/>
				<meta name="twitter:card" content="summary_large_image"/>
			}
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="min-h-dvh bg-base-200">
			<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-10 focus:m-2 focus:btn focus:btn-primary">Aller au contenu</a>
			if page.Nav.visible() {
				@shell(page.Nav) {
					{ children... }
				}
			} else {
				<header class="border-b border-base-300 bg-base-100">
					<div class="mx-auto flex min-h-14 max-w-2xl items-center px-4">
						<span class="text-base font-semibold tracking-tight">Garageband</span>
					</div>
				</header>
				<main id="main" class="mx-auto w-full max-w-2xl px-4 py-6 sm:py-10">
					{ children... }
				</main>
			}
		</body>
	</html>
}

// shell is the signed-in application shell: a daisyUI drawer whose side panel
// carries the brand, which workspace you are in, the site switcher, the
// primary navigation, and the way out. It only links to screens that exist.
// Verified against https://daisyui.com/components/drawer/ and
// https://daisyui.com/components/menu/ 2026-08-03.
templ shell(nav Nav) {
	<div class="drawer lg:drawer-open">
		<input id="app-drawer" type="checkbox" class="drawer-toggle"/>
		<div class="drawer-content flex min-h-dvh flex-col">
			<div class="navbar border-b border-base-300 bg-base-100 lg:hidden">
				<label for="app-drawer" aria-label="Ouvrir le menu" class="btn btn-square btn-ghost">
					@hamburgerIcon()
				</label>
				<a href="/" class="px-2 text-base font-semibold tracking-tight">Garageband</a>
			</div>
			<main id="main" class="mx-auto w-full max-w-2xl flex-1 px-4 py-6 sm:py-10">
				{ children... }
			</main>
		</div>
		<div class="drawer-side z-10">
			<label for="app-drawer" aria-label="Fermer le menu" class="drawer-overlay"></label>
			<aside class="flex min-h-full w-64 flex-col gap-1 border-r border-base-300 bg-base-100 p-4">
				<a href="/" class="mb-1 text-base font-semibold tracking-tight">Garageband</a>
				if nav.Workspace != "" {
					<p class="mb-2 truncate text-sm opacity-60">{ nav.Workspace }</p>
				}
				if nav.InWorkspace {
					<a
						href="/locations"
						aria-current={ nav.current(SectionLocations) }
						class={ "btn btn-ghost btn-block mb-2 justify-start",
							templ.KV("btn-active font-semibold", nav.Section == SectionLocations) }
					>
						Sites
					</a>
				}
				<nav aria-label="Navigation principale" class="flex-1">
					<ul class="menu w-full p-0">
						@navLink("/", "Tableau de bord", nav.current(SectionDashboard))
						if nav.InWorkspace {
							@navLink("/team", "Équipe", nav.current(SectionTeam))
							@navLink("/customers", "Clients", nav.current(SectionCustomers))
							@navLink("/agenda", "Agenda", nav.current(SectionAgenda))
							@navLink("/calls", "Appels", nav.current(SectionCalls))
							@navLink("/agents", "Agent IA", nav.current(SectionAgents))
							@navLink("/catalog", "Catalogue", nav.current(SectionCatalog))
							@navLink("/assistant", "Assistant", nav.current(SectionAssistant))
						}
					</ul>
				</nav>
				<form method="post" action="/logout">
					<button type="submit" class="btn btn-ghost btn-sm btn-block">Déconnexion</button>
				</form>
			</aside>
		</div>
	</div>
}

// hamburgerIcon toggles the drawer on small screens; the drawer-toggle
// checkbox does the actual work, this is only its visible label.
templ hamburgerIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
	</svg>
}

// navLink marks the current page with aria-current and with weight, so the
// state does not rest on the background colour alone.
templ navLink(href string, label string, current string) {
	<li>
		<a
			href={ templ.URL(href) }
			aria-current={ current }
			class={ templ.KV("menu-active font-semibold", current == "page") }
		>
			{ label }
		</a>
	</li>
}
