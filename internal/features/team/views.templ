package team

import "github.com/esrid/garageband/internal/ui"

// Interface copy is French; identifiers and comments stay English.

// pendingHandle renders the submit-pending script once per page. Every form
// here is a plain POST and works unchanged without it.
var pendingHandle = templ.NewOnceHandle()

// Index lists the organization's members and the sites each of them reaches.
templ Index(page Page) {
	@ui.Layout(ui.PageInfo{
		Title:   "Accès aux sites",
		NoIndex: true,
		Nav:     ui.Nav{Section: ui.SectionTeam, Workspace: page.Organization, InWorkspace: true},
	}) {
		<div class="grid gap-5">
			<header class="grid gap-1">
				<h1 class="text-xl font-semibold">Accès aux sites</h1>
				<p class="text-sm opacity-70">
					Qui travaille sur quel atelier. Les propriétaires et les administrateurs
					atteignent tous les sites ; les responsables et les membres uniquement
					ceux que vous leur donnez.
				</p>
			</header>
			@notice(page.Notice)
			if !page.CanManage {
				<div role="status" class="alert items-start text-left">
					@infoIcon()
					<span class="text-sm">
						Vous consultez ces accès en lecture seule. Seul un propriétaire ou un
						administrateur de l'espace peut les modifier.
					</span>
				</div>
			}
			if page.UnassignedCount() > 0 {
				<div role="status" class="alert alert-warning items-start text-left">
					@warningIcon()
					<div class="grid gap-1">
						<span class="font-semibold">{ unassignedHeading(page.UnassignedCount()) }</span>
						<span class="text-sm">
							Sans site, une personne peut se connecter mais ne voit aucun client,
							aucun rendez-vous et aucune réparation.
						</span>
					</div>
				</div>
			}
			@inviteLink(page)
			if page.CanManage && len(page.Locations) > 0 {
				@inviteForm(page)
			}
			if len(page.Locations) == 0 {
				<div class="card card-border border-base-300 bg-base-100">
					<div class="card-body items-start gap-2 p-5">
						if page.CanManage {
							<h2 class="text-base font-semibold">Aucun site à attribuer</h2>
							<p class="text-sm opacity-70">
								Créez d'abord un site : il n'y a rien à donner tant que votre garage
								n'a pas d'atelier.
							</p>
							<a href="/locations" class="btn btn-primary mt-1 min-h-11">Voir les sites</a>
						} else {
							<h2 class="text-base font-semibold">Aucun site accessible</h2>
							<p class="text-sm opacity-70">
								Demandez à un propriétaire ou à un administrateur de vous attribuer
								au moins un site.
							</p>
						}
					</div>
				</div>
			} else {
				<ul class="grid gap-3">
					for _, member := range page.Members {
						<li>
							@memberCard(member, page)
						</li>
					}
				</ul>
			}
		</div>
		@pendingHandle.Once() {
			@pendingScript()
		}
	}
}

// inviteLink shows a freshly minted link exactly once. It is deliberately loud:
// the owner has one chance to hand it over, and nothing can recover it after
// this render.
templ inviteLink(page Page) {
	if page.Invite.Code != "" {
		<div role="alert" class="alert alert-success items-start text-left">
			@successIcon()
			<div class="grid w-full gap-3">
				<span class="font-semibold">{ "Code d'accès de " + page.InvitedName }</span>
				<output class="rounded-box bg-base-100 px-4 py-3 text-center font-mono text-2xl font-semibold tracking-[0.25em] text-base-content">
					{ groupInviteCode(page.Invite.Code) }
				</output>
				<span class="text-sm">
					Sur n'importe quel ordinateur, la personne ouvre <span class="font-medium">/rejoindre</span>
					et tape ce code. Rien à installer, aucun compte à créer.
				</span>
				<details>
					<summary class="min-h-11 cursor-pointer py-2 text-sm font-medium">
						Envoyer un lien à la place
					</summary>
					<input
						type="text"
						class="input input-bordered mt-2 w-full font-mono text-xs"
						value={ page.Invite.Link }
						readonly
						aria-label={ "Lien d'invitation de " + page.InvitedName }
						onfocus="this.select()"
					/>
				</details>
				<span class="text-xs opacity-70">
					Le code ne sert qu'une fois et ne sera plus affiché. Pour un deuxième
					appareil, générez-en un nouveau.
				</span>
			</div>
		</div>
	}
}

// inviteForm enrols someone by name alone. No email, no password, no role
// picker: every employee is a member, and the owner changes nothing else.
templ inviteForm(page Page) {
	<details class="collapse-arrow collapse border border-base-300 bg-base-100">
		<summary class="collapse-title min-h-11 py-3 font-medium">Ajouter un employé</summary>
		<div class="collapse-content">
			<form method="post" action="/team/invite" class="grid gap-3" data-pending-form>
				<label class="floating-label">
					<span>Prénom et nom</span>
					<input
						type="text"
						name={ FieldName }
						class="input input-bordered w-full"
						placeholder="Prénom et nom"
						required
						maxlength="120"
						autocomplete="off"
					/>
				</label>
				<fieldset class="fieldset gap-2 p-0">
					<legend class="fieldset-legend px-0 text-sm">Sites accessibles</legend>
					for _, location := range page.Locations {
						<label class="label min-h-11 cursor-pointer justify-start gap-3" for={ "invite-" + location.ID }>
							<input
								type="checkbox"
								id={ "invite-" + location.ID }
								name={ FieldLocations }
								value={ location.ID }
								class="checkbox"
							/>
							<span class="flex flex-wrap items-center gap-2 text-base-content">
								{ location.Name }
								if !location.Active {
									<span class="badge badge-sm">Inactif</span>
								}
							</span>
						</label>
					}
				</fieldset>
				<p class="text-xs opacity-60">
					Vous obtiendrez un lien à lui transmettre. Il n'a besoin ni d'adresse
					e-mail, ni de mot de passe, ni de compte Google.
				</p>
				<button type="submit" class="btn btn-primary min-h-11 w-full sm:w-auto sm:justify-self-start" data-pending-label="Création…">
					Créer son accès
				</button>
			</form>
		</div>
	</details>
}

// memberCard shows who someone is and what they reach, and — for the roles
// where it is editable — folds the site checkboxes away until asked for.
templ memberCard(member Member, page Page) {
	<article class="card card-border border-base-300 bg-base-100">
		<div class="card-body gap-3 p-5">
			<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
				<h2 class="text-base font-semibold">{ member.Label() }</h2>
				<span class="flex shrink-0 flex-wrap items-center gap-2">
					if member.Invited() {
						<span class={ "badge badge-sm", templ.KV("badge-warning", member.InviteExpired()) }>
							{ inviteStateLabel(member) }
						</span>
					}
					<span class="badge badge-sm">{ roleLabel(member.Role) }</span>
				</span>
			</div>
			if member.Name != "" && member.Email != "" {
				<p class="text-xs opacity-60">{ member.Email }</p>
			}
			<p class="text-sm">
				<span class="opacity-60">Accès :</span>
				if member.Unassigned() {
					<span class="font-medium">Aucun site</span>
				} else {
					<span class="opacity-80">{ accessSummary(member, page.Locations) }</span>
				}
			</p>
			if member.ReachesEveryLocation() {
				<p class="text-xs opacity-60">
					Ce rôle donne accès à tous les sites, présents et futurs. Pour le
					restreindre, changez le rôle de la personne.
				</p>
			} else if page.CanManage {
				<details class="collapse-arrow collapse border border-base-300 bg-base-200">
					<summary class="collapse-title min-h-11 py-3 text-sm font-medium">
						Modifier ses sites<span class="sr-only">{ " pour " + member.Label() }</span>
					</summary>
					<div class="collapse-content">
						<form method="post" action={ templ.URL(assignmentPath(member)) } class="grid gap-3" data-pending-form>
							<fieldset class="fieldset gap-2 p-0">
								<legend class="fieldset-legend px-0 text-sm">
									{ "Sites de " + member.Label() }
								</legend>
								for _, location := range page.Locations {
									<label class="label min-h-11 cursor-pointer justify-start gap-3" for={ checkboxID(member, location) }>
										<input
											type="checkbox"
											id={ checkboxID(member, location) }
											name={ FieldLocations }
											value={ location.ID }
											class="checkbox"
											checked?={ member.HasLocation(location.ID) }
										/>
										<span class="flex flex-wrap items-center gap-2 text-base-content">
											{ location.Name }
											if !location.Active {
												<span class="badge badge-sm">Inactif</span>
											}
										</span>
									</label>
								}
							</fieldset>
							<p class="text-xs opacity-60">
								Décocher un site retire l'accès sans effacer ce que la personne y a
								déjà enregistré.
							</p>
							<button type="submit" class="btn btn-primary min-h-11 w-full sm:w-auto sm:justify-self-start" data-pending-label="Enregistrement…">
								Enregistrer ses sites
							</button>
						</form>
					</div>
				</details>
			}
			if page.CanManage && member.Removable() {
				<details class="collapse-arrow collapse border border-base-300 bg-base-200">
					<summary class="collapse-title min-h-11 py-3 text-sm font-medium">
						Corriger son nom<span class="sr-only">{ " de " + member.Label() }</span>
					</summary>
					<div class="collapse-content">
						<form method="post" action={ templ.URL(namePath(member)) } class="grid gap-3" data-pending-form>
							<label class="floating-label" for={ nameFieldID(member) }>
								<span>Prénom et nom</span>
								<input
									type="text"
									id={ nameFieldID(member) }
									name={ FieldName }
									class="input input-bordered w-full"
									placeholder="Prénom et nom"
									value={ member.Name }
									required
									maxlength="120"
									autocomplete="off"
								/>
							</label>
							<p class="text-xs opacity-60">
								Corriger le nom ne touche ni à son accès, ni à ses ateliers, ni à
								son code.
							</p>
							<button type="submit" class="btn btn-primary min-h-11 w-full sm:w-auto sm:justify-self-start" data-pending-label="Enregistrement…">
								Enregistrer son nom
							</button>
						</form>
					</div>
				</details>
				<div class="flex flex-wrap gap-2">
					<form method="post" action={ templ.URL(codePath(member)) } data-pending-form>
						<button type="submit" class="btn btn-sm min-h-11" data-pending-label="Génération…">
							Nouveau code<span class="sr-only">{ " pour " + member.Label() }</span>
						</button>
					</form>
					<form method="post" action={ templ.URL(revokePath(member)) } data-pending-form>
						<button type="submit" class="btn btn-error btn-sm min-h-11" data-pending-label="Retrait…">
							Retirer de l'équipe<span class="sr-only">{ " " + member.Label() }</span>
						</button>
					</form>
				</div>
			}
		</div>
	</article>
}

// notice reports a server-side outcome. An icon and a heading carry the
// meaning, so no state depends on colour alone.
templ notice(n Notice) {
	if !n.Empty() {
		<div role="alert" class={ "alert items-start text-left", noticeColor(n.Kind) }>
			if n.Kind == NoticeSuccess {
				@successIcon()
			} else {
				@warningIcon()
			}
			<div class="grid gap-1">
				<span class="font-semibold">{ noticeTitle(n.Kind) }</span>
				<span class="text-sm">{ n.Message }</span>
			</div>
		</div>
	}
}

templ warningIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"></path>
	</svg>
}

templ successIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
	</svg>
}

templ infoIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"></path>
	</svg>
}

templ pendingScript() {
	<script>
		document.querySelectorAll("[data-pending-form]").forEach(function (form) {
			form.addEventListener("submit", function (event) {
				var button = event.submitter;
				if (!button || !button.dataset.pendingLabel) {
					return;
				}
				var label = button.dataset.pendingLabel;
				// Disabling synchronously here would drop the submitter's own
				// name/value from the request the browser is about to send -
				// defer one tick so submission happens first.
				setTimeout(function () {
					button.disabled = true;
					button.innerHTML = '<span class="loading loading-spinner loading-sm"></span>' + label;
				}, 0);
			});
		});
	</script>
}
