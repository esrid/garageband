package locations

import (
	"strconv"

	"github.com/esrid/garageband/internal/ui"
)

// Interface copy is French; identifiers and comments stay English.

// pendingHandle renders the submit-pending script once per page. Every form
// here is a plain POST and works unchanged without it.
var pendingHandle = templ.NewOnceHandle()

// Index lists the organization's physical sites.
templ Index(page IndexPage) {
	@ui.Layout(ui.PageInfo{Title: "Sites du garage", NoIndex: true, Nav: ui.Nav{Section: ui.SectionLocations, Workspace: page.Organization, InWorkspace: true}}) {
		<div class="grid gap-5">
			<h1 class="text-xl font-semibold">Sites du garage</h1>
			@notice(page.Notice)
			<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				<p class="max-w-md text-sm opacity-70">
					Un seul site suffit pour faire tourner votre garage. N'en ajoutez d'autres
					que si vous recevez des clients dans plusieurs ateliers.
				</p>
				if page.CanManage {
					<a href="/locations/new" class="btn btn-primary min-h-11 shrink-0">Ajouter un site</a>
				}
			</div>
			if !page.CanManage {
				<div role="status" class="alert items-start text-left">
					@infoIcon()
					<span class="text-sm">
						Vous consultez ces sites en lecture seule. Seul un propriétaire de
						l'espace peut les modifier.
					</span>
				</div>
			}
			if len(page.Locations) == 0 {
				<div class="card card-border border-base-300 bg-base-100">
					<div class="card-body items-start gap-2">
						<h2 class="card-title text-base">Aucun site pour l'instant</h2>
						<p class="text-sm opacity-70">
							Votre garage a besoin d'au moins un site pour recevoir des appels et
							des rendez-vous.
						</p>
					</div>
				</div>
			} else {
				<ul class="grid gap-3">
					for _, location := range page.Locations {
						<li>
							@locationCard(location, page.CanManage, location.ID == page.ActiveLocationID)
						</li>
					}
				</ul>
				if page.HasInactive() {
					<p class="text-xs opacity-70">
						Un site désactivé ne reçoit plus ni appels ni rendez-vous, mais son
						historique reste consultable. Vous pouvez le rouvrir à tout moment.
					</p>
				}
			}
		</div>
		@pendingHandle.Once() {
			@pendingScript()
		}
	}
}

// locationCard leads with what identifies a site — its name, whether it is open
// and where it is — and keeps the rest as quiet secondary text.
templ locationCard(location Location, canManage bool, isActiveSite bool) {
	<article
		class={ "card card-border border-base-300",
			templ.KV("bg-base-100", isActive(location)),
			templ.KV("border-dashed bg-base-200", !isActive(location)) }
	>
		<div class="card-body gap-3 p-5">
			<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
				<h2 class="text-base font-semibold">{ location.Name }</h2>
				<div class="flex items-center gap-1">
					if isActiveSite {
						<span class="badge badge-outline badge-sm">Site actuel</span>
					}
					if isActive(location) {
						<span class="badge badge-success badge-sm">Actif</span>
					} else {
						<span class="badge badge-sm">Inactif</span>
					}
				</div>
			</div>
			<p class="text-sm opacity-70">
				if len(addressLines(location)) == 0 {
					Adresse non renseignée
				} else {
					for index, line := range addressLines(location) {
						if index > 0 {
							<span class="opacity-50">{ ", " }</span>
						}
						{ line }
					}
				}
			</p>
			if len(metaFacts(location)) > 0 {
				<p class="text-xs opacity-60">
					for index, fact := range metaFacts(location) {
						if index > 0 {
							<span aria-hidden="true">{ " · " }</span>
						}
						{ fact }
					}
				</p>
			}
			@setupMeter(location)
			if canManage {
				<div class="mt-1 flex flex-col gap-2 sm:flex-row">
					<a href={ templ.URL("/locations/" + location.ID) } class="btn btn-sm min-h-11 sm:min-h-9">
						Configurer<span class="sr-only">{ " " + location.Name }</span>
					</a>
					if !isActiveSite && isActive(location) {
						<form method="post" action={ templ.URL("/locations/" + location.ID + "/activate") } data-pending-form>
							<button type="submit" class="btn btn-ghost btn-sm min-h-11 w-full sm:min-h-9 sm:w-auto" data-pending-label="Sélection…">
								Définir comme site actif<span class="sr-only">{ " " + location.Name }</span>
							</button>
						</form>
					}
					if isActive(location) {
						<form method="post" action={ templ.URL("/locations/" + location.ID + "/deactivate") } data-pending-form data-confirm={ "Désactiver « " + location.Name + " » ? Le site ne recevra plus d'appels ni de rendez-vous." }>
							<button type="submit" class="btn btn-ghost btn-sm min-h-11 w-full sm:min-h-9 sm:w-auto" data-pending-label="Désactivation…">
								Désactiver<span class="sr-only">{ " " + location.Name }</span>
							</button>
						</form>
					} else {
						<form method="post" action={ templ.URL("/locations/" + location.ID + "/reactivate") } data-pending-form>
							<button type="submit" class="btn btn-sm min-h-11 w-full sm:min-h-9 sm:w-auto" data-pending-label="Réouverture…">
								Réactiver<span class="sr-only">{ " " + location.Name }</span>
							</button>
						</form>
					}
				</div>
			}
		</div>
	</article>
}

// setupMeter shows how ready a site is. The count and the list of what is
// missing carry the meaning, so it never relies on the bar alone.
templ setupMeter(location Location) {
	{{ setup := setupOf(location) }}
	<div class="grid gap-1">
		<div class="flex items-center gap-2 text-xs">
			<progress
				class={ "progress h-1.5 w-20 shrink-0", templ.KV("progress-success", setup.Complete()) }
				value={ setupValue(setup) }
				max={ setupMax(setup) }
				aria-label={ "Configuration du site " + location.Name }
			></progress>
			<span class="opacity-70">
				if setup.Complete() {
					Configuration complète
				} else {
					Configuration { setupCount(setup) }
				}
			</span>
		</div>
		if !setup.Complete() {
			<p class="text-xs opacity-60">
				Il manque :
				for index, key := range setup.Missing {
					if index > 0 {
						<span aria-hidden="true">{ ", " }</span>
					}
					<a class="link link-hover" href={ templ.URL(setupPath(location.ID, key)) }>{ fieldLabel(key) }</a>
				}
			</p>
		}
	</div>
}

// Form adds a site or edits an existing one; both use the same screen.
templ Form(page FormPage) {
	@ui.Layout(ui.PageInfo{Title: formTitle(page), NoIndex: true, Nav: ui.Nav{Section: ui.SectionLocations, InWorkspace: true}}) {
		<div class="grid gap-5">
			<header class="grid gap-1">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<h1 class="text-xl font-semibold">{ formTitle(page) }</h1>
					if !page.IsNew() {
						<a href={ templ.URL("/locations/" + page.ID + "/schedule") } class="btn btn-sm min-h-11 sm:min-h-9">Horaires et fermetures</a>
					}
				</div>
				<p class="text-sm opacity-70">
					if page.IsNew() {
						Un site est un atelier où vos clients se rendent. Vous pourrez le
						modifier à tout moment.
					} else {
						Ces informations servent à vos clients et à votre agent téléphonique.
					}
				</p>
			</header>
			@notice(page.Notice)
			if !page.CanManage {
				@readOnlyLocation(page)
			} else {
				<form method="post" action={ templ.URL(formActionPath(page)) } class="grid gap-4" data-pending-form novalidate>
					<section id="location-identity" class="card card-border border-base-300 bg-base-100">
						<div class="card-body gap-4 p-5">
							<h2 class="text-base font-semibold">Identité du site</h2>
							<div class="grid gap-4 sm:grid-cols-2">
								@field(page, FieldName, "Nom du site", true, "Par exemple : Atelier principal, ou le nom de la rue.", true) {
									<input
										id={ FieldName }
										name={ FieldName }
										class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldName)) }
										value={ page.Values.Name }
										aria-invalid={ ariaInvalid(page.HasError(FieldName)) }
										aria-describedby={ describedBy(FieldName, true, page.HasError(FieldName)) }
										required
									/>
								}
								@field(page, FieldSIRET, "SIRET", false, "14 chiffres. Chaque établissement a le sien.", true) {
									<input
										id={ FieldSIRET }
										name={ FieldSIRET }
										class={ "input min-h-11 w-full font-mono tracking-wider", templ.KV("input-error", page.HasError(FieldSIRET)) }
										value={ page.Values.SIRET }
										inputmode="numeric"
										maxlength="14"
										aria-invalid={ ariaInvalid(page.HasError(FieldSIRET)) }
										aria-describedby={ describedBy(FieldSIRET, true, page.HasError(FieldSIRET)) }
									/>
								}
							</div>
						</div>
					</section>
					<section id="location-address" class="card card-border border-base-300 bg-base-100">
						<div class="card-body gap-4 p-5">
							<h2 class="text-base font-semibold">Adresse</h2>
							<div class="grid gap-4 sm:grid-cols-2">
								@field(page, FieldAddressLine1, "Adresse", true, "", true) {
									<input
										id={ FieldAddressLine1 }
										name={ FieldAddressLine1 }
										class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldAddressLine1)) }
										value={ page.Values.AddressLine1 }
										autocomplete="address-line1"
										aria-invalid={ ariaInvalid(page.HasError(FieldAddressLine1)) }
										aria-describedby={ describedBy(FieldAddressLine1, false, page.HasError(FieldAddressLine1)) }
										required
									/>
								}
								@field(page, FieldAddressLine2, "Complément d'adresse", false, "Bâtiment, étage ou zone d'activité.", true) {
									<input
										id={ FieldAddressLine2 }
										name={ FieldAddressLine2 }
										class="input min-h-11 w-full"
										value={ page.Values.AddressLine2 }
										autocomplete="address-line2"
										aria-describedby={ describedBy(FieldAddressLine2, true, false) }
									/>
								}
								@field(page, FieldPostalCode, "Code postal", true, "", false) {
									<input
										id={ FieldPostalCode }
										name={ FieldPostalCode }
										class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldPostalCode)) }
										value={ page.Values.PostalCode }
										inputmode="numeric"
										autocomplete="postal-code"
										aria-invalid={ ariaInvalid(page.HasError(FieldPostalCode)) }
										aria-describedby={ describedBy(FieldPostalCode, false, page.HasError(FieldPostalCode)) }
										required
									/>
								}
								@field(page, FieldCity, "Ville", true, "", false) {
									<input
										id={ FieldCity }
										name={ FieldCity }
										class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldCity)) }
										value={ page.Values.City }
										autocomplete="address-level2"
										aria-invalid={ ariaInvalid(page.HasError(FieldCity)) }
										aria-describedby={ describedBy(FieldCity, false, page.HasError(FieldCity)) }
										required
									/>
								}
								@field(page, FieldCountry, "Pays", true, "", false) {
									<select
										id={ FieldCountry }
										name={ FieldCountry }
										class={ "select min-h-11 w-full", templ.KV("select-error", page.HasError(FieldCountry)) }
										aria-invalid={ ariaInvalid(page.HasError(FieldCountry)) }
										aria-describedby={ describedBy(FieldCountry, false, page.HasError(FieldCountry)) }
										required
									>
										for _, option := range countryOptions {
											<option value={ option.Value } selected?={ option.Value == page.Values.CountryCode }>{ option.Label }</option>
										}
									</select>
								}
								@field(page, FieldTimezone, "Fuseau horaire", true, "Sert à placer les rendez-vous à la bonne heure.", false) {
									<select
										id={ FieldTimezone }
										name={ FieldTimezone }
										class={ "select min-h-11 w-full", templ.KV("select-error", page.HasError(FieldTimezone)) }
										aria-invalid={ ariaInvalid(page.HasError(FieldTimezone)) }
										aria-describedby={ describedBy(FieldTimezone, true, page.HasError(FieldTimezone)) }
										required
									>
										for _, option := range timezoneOptions {
											<option value={ option.Value } selected?={ option.Value == page.Values.Timezone }>{ option.Label }</option>
										}
									</select>
								}
							</div>
						</div>
					</section>
					<section id="location-contact" class="card card-border border-base-300 bg-base-100">
						<div class="card-body gap-4 p-5">
							<h2 class="text-base font-semibold">Contact</h2>
							<p class="text-sm opacity-70">
								Ce que vos clients voient, et ce que votre agent téléphonique peut
								donner au téléphone.
							</p>
							<div class="grid gap-4 sm:grid-cols-2">
								@field(page, FieldPhone, "Téléphone", false, "Format international, par exemple +33472000000.", false) {
									<input
										id={ FieldPhone }
										name={ FieldPhone }
										type="tel"
										class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldPhone)) }
										value={ page.Values.PhoneE164 }
										inputmode="tel"
										autocomplete="tel"
										aria-invalid={ ariaInvalid(page.HasError(FieldPhone)) }
										aria-describedby={ describedBy(FieldPhone, true, page.HasError(FieldPhone)) }
									/>
								}
								@field(page, FieldEmail, "E-mail", false, "", false) {
									<input
										id={ FieldEmail }
										name={ FieldEmail }
										type="email"
										class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldEmail)) }
										value={ page.Values.Email }
										inputmode="email"
										autocomplete="email"
										aria-invalid={ ariaInvalid(page.HasError(FieldEmail)) }
										aria-describedby={ describedBy(FieldEmail, false, page.HasError(FieldEmail)) }
									/>
								}
								@field(page, FieldWebsite, "Site web", false, "Commence par https://.", true) {
									<input
										id={ FieldWebsite }
										name={ FieldWebsite }
										type="url"
										class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldWebsite)) }
										value={ page.Values.WebsiteURL }
										placeholder="https://"
										inputmode="url"
										aria-invalid={ ariaInvalid(page.HasError(FieldWebsite)) }
										aria-describedby={ describedBy(FieldWebsite, true, page.HasError(FieldWebsite)) }
									/>
								}
							</div>
						</div>
					</section>
					<div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center sm:justify-between">
						<a href="/locations" class="btn btn-ghost min-h-11 sm:w-auto">Annuler</a>
						<button type="submit" class="btn btn-primary min-h-11 sm:w-auto" data-pending-label="Enregistrement…">
							if page.IsNew() {
								Ajouter le site
							} else {
								Enregistrer les modifications
							}
						</button>
					</div>
				</form>
				if !page.IsNew() {
					if page.CalendarOffered {
						@calendarSection(page)
					}
					@lifecycleSection(page)
				}
			}
		</div>
		@pendingHandle.Once() {
			@pendingScript()
		}
	}
}

// Schedule configures the local weekly clock used by availability searches
// and the exceptional periods during which the whole workshop is closed.
templ ScheduleView(page SchedulePage) {
	@ui.Layout(ui.PageInfo{Title: "Horaires de " + page.Location.Name, NoIndex: true, Nav: ui.Nav{Section: ui.SectionLocations, Workspace: page.Organization, InWorkspace: true}}) {
		<div class="grid gap-5">
			<header class="grid gap-2">
				<a href={ templ.URL("/locations/" + page.Location.ID) } class="link text-sm">← Revenir au site</a>
				<h1 class="text-xl font-semibold">Horaires et fermetures</h1>
				<p class="text-sm opacity-70">{ page.Location.Name } · { page.Location.Timezone }</p>
			</header>
			@notice(page.Notice)
			if !page.CanManage {
				<div role="status" class="alert items-start text-left">
					@infoIcon()
					<span class="text-sm">Vous consultez ce planning en lecture seule.</span>
				</div>
			}
			<section class="card card-border border-base-300 bg-base-100" aria-labelledby="weekly-hours-heading">
				<div class="card-body gap-4 p-5">
					<div class="grid gap-1">
						<h2 id="weekly-hours-heading" class="text-base font-semibold">Horaires hebdomadaires</h2>
						<p class="text-sm opacity-70">
							Les rendez-vous doivent tenir entièrement dans une plage. Vous pouvez ajouter deux plages pour une journée avec pause déjeuner.
						</p>
					</div>
					if !page.Enabled {
						<div role="status" class="alert alert-warning items-start text-left">
							@infoIcon()
							<span class="text-sm">La recherche de créneaux attend votre première plage d’ouverture. Les rendez-vous existants ne sont pas modifiés.</span>
						</div>
					}
					<ul class="divide-y divide-base-300 rounded-box border border-base-300">
						for _, day := range weekdayOptions {
							{{ hours := page.HoursFor(weekdayNumber(day)) }}
							<li class="grid gap-2 p-3 sm:grid-cols-[8rem_1fr] sm:items-start">
								<span class="font-medium">{ day.Label }</span>
								if len(hours) == 0 {
									<span class="text-sm opacity-60">Fermé</span>
								} else {
									<ul class="grid gap-2">
										for _, opening := range hours {
											<li class="flex flex-wrap items-center justify-between gap-2">
												<span class="font-mono text-sm">{ opening.OpensAt }–{ opening.ClosesAt }</span>
												if page.CanManage {
													<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/hours/delete") } data-confirm={ "Retirer la plage du " + day.Label + " de " + opening.OpensAt + " à " + opening.ClosesAt + " ?" }>
														<input type="hidden" name={ FieldWeekday } value={ strconv.Itoa(opening.Weekday) }/>
														<input type="hidden" name={ FieldOpensAt } value={ opening.OpensAt }/>
														<input type="hidden" name={ FieldClosesAt } value={ opening.ClosesAt }/>
														<button type="submit" class="btn btn-ghost btn-sm min-h-11 sm:min-h-9">Retirer<span class="sr-only"> { day.Label } { opening.OpensAt } à { opening.ClosesAt }</span></button>
													</form>
												}
											</li>
										}
									</ul>
								}
							</li>
						}
					</ul>
					if page.CanManage {
						<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/hours") } class="grid gap-3 sm:grid-cols-4 sm:items-end" novalidate>
							<label class="form-control grid gap-1">
								<span class="label-text text-sm font-medium">Jour</span>
								<select name={ FieldWeekday } class={ "select min-h-11 w-full", templ.KV("select-error", page.HasError(FieldWeekday)) }>
									for _, day := range weekdayOptions {
										<option value={ day.Value } selected?={ weekdayNumber(day) == page.HourValues.Weekday }>{ day.Label }</option>
									}
								</select>
								if page.HasError(FieldWeekday) {
									<span class="text-error text-xs">{ page.Error(FieldWeekday) }</span>
								}
							</label>
							@timeField(FieldOpensAt, "Ouverture", page.HourValues.OpensAt, page.Error(FieldOpensAt))
							@timeField(FieldClosesAt, "Fermeture", page.HourValues.ClosesAt, page.Error(FieldClosesAt))
							<button type="submit" class="btn btn-primary min-h-11">Ajouter la plage</button>
						</form>
					}
				</div>
			</section>
			<section class="card card-border border-base-300 bg-base-100" aria-labelledby="capacity-heading">
				<div class="card-body gap-5 p-5">
					<div class="grid gap-1">
						<h2 id="capacity-heading" class="text-base font-semibold">Capacité de l’atelier</h2>
						<p class="text-sm opacity-70">Déclarez les techniciens, ponts et équipements, puis ce que chaque prestation immobilise. L’agenda choisira automatiquement un ensemble libre.</p>
					</div>
					<div class="grid gap-3">
						<h3 class="text-sm font-semibold">Ressources</h3>
						if len(page.Resources) == 0 {
							<p class="text-sm opacity-60">Aucune ressource configurée.</p>
						} else {
							<ul class="grid gap-2 sm:grid-cols-2">
								for _, resource := range page.Resources {
									<li class={ "flex items-center justify-between gap-3 rounded-box border border-base-300 p-3", templ.KV("opacity-55", !resource.Active) }>
										<div class="grid gap-0.5">
											<span class="text-sm font-medium">{ resource.Name }</span>
											<span class="text-xs opacity-60">{ resourceKindLabel(resource.Kind) } · { resourceStatusLabel(resource.Active) }</span>
										</div>
										if page.CanManage {
											<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/resources/" + resource.ID + "/active") }>
												<input type="hidden" name={ FieldResourceActive } value={ strconv.FormatBool(!resource.Active) }/>
												<button type="submit" class="btn btn-ghost btn-sm min-h-11 sm:min-h-9">{ resourceActionLabel(resource.Active) }</button>
											</form>
										}
									</li>
								}
							</ul>
						}
						if page.CanManage {
							<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/resources") } class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end" novalidate>
								<label class="form-control grid gap-1">
									<span class="label-text text-sm font-medium">Type</span>
									<select name={ FieldResourceKind } class={ "select min-h-11 w-full", templ.KV("select-error", page.HasError(FieldResourceKind)) }>
										for _, kind := range resourceKindOptions {
											<option value={ kind.Value } selected?={ kind.Value == page.ResourceValues.Kind }>{ kind.Label }</option>
										}
									</select>
									if page.HasError(FieldResourceKind) {
										<span class="text-error text-xs">{ page.Error(FieldResourceKind) }</span>
									}
								</label>
								<label class="form-control grid gap-1">
									<span class="label-text text-sm font-medium">Nom</span>
									<input name={ FieldResourceName } value={ page.ResourceValues.Name } maxlength="120" class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldResourceName)) } placeholder="Pont 1" required/>
									if page.HasError(FieldResourceName) {
										<span class="text-error text-xs">{ page.Error(FieldResourceName) }</span>
									}
								</label>
								<button type="submit" class="btn min-h-11">Ajouter</button>
							</form>
						}
					</div>
					<div class="divider my-0"></div>
					<div class="grid gap-3">
						<div class="grid gap-1">
							<h3 class="text-sm font-semibold">Prestations réservables</h3>
							<p class="text-sm opacity-70">Le nom, la durée et le prix restent pilotés par le catalogue. Désactiver ici conserve les rendez-vous et l’historique.</p>
						</div>
						if len(page.Services) == 0 {
							<p class="text-sm opacity-60">Aucune prestation n’est encore réservable dans ce site.</p>
						} else {
							<ul class="grid gap-2 sm:grid-cols-2">
								for _, service := range page.Services {
									<li class={ "grid gap-2 rounded-box border border-base-300 p-3", templ.KV("opacity-60", !service.Active) }>
										<div class="flex items-start justify-between gap-3">
											<div class="grid gap-0.5">
												<span class="text-sm font-medium">{ service.Name }</span>
												<span class="text-xs opacity-60">{ strconv.Itoa(service.Duration) } min · { schedulingStatusLabel(service.Active) }</span>
											</div>
											if service.CatalogItemID != "" {
												<span class="badge badge-outline badge-sm">Catalogue</span>
											}
										</div>
										if service.CatalogItemID != "" {
											<div class="flex flex-wrap items-center justify-between gap-2 text-xs">
												<a href={ templ.URL("/catalog/" + service.CatalogItemID) } class="link">{ catalogPriceLabel(service.Price) }</a>
												if service.CatalogReference != "" {
													<span class="font-mono opacity-60">{ service.CatalogReference }</span>
												}
											</div>
											if !service.CatalogAvailable {
												<p class="text-warning text-xs">Le catalogue ne permet plus cette prestation dans ce site.</p>
											}
											if page.CanManage {
												<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/services/" + service.ID + "/active") }>
													<input type="hidden" name={ FieldCatalogServiceActive } value={ strconv.FormatBool(!service.CatalogLinkEnabled) }/>
													<button type="submit" class="btn btn-ghost btn-sm min-h-11 sm:min-h-9" disabled?={ !service.CatalogAvailable && !service.CatalogLinkEnabled }>{ schedulingActionLabel(service.CatalogLinkEnabled) }</button>
												</form>
											}
										} else {
											<span class="text-xs opacity-60">Prestation historique non liée au catalogue</span>
										}
									</li>
								}
							</ul>
						}
						if page.CanManage {
							if len(page.CatalogItems) == 0 {
								<p class="text-xs opacity-60">Toutes les prestations du catalogue avec une durée sont déjà reliées, ou aucune ne s’applique à ce site.</p>
							} else {
								<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/services") } class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end" novalidate>
									<label class="form-control grid gap-1">
										<span class="label-text text-sm font-medium">Ajouter depuis le catalogue</span>
										<select name={ FieldCatalogItem } class={ "select min-h-11 w-full", templ.KV("select-error", page.HasError(FieldCatalogItem)) } required>
											<option value="">Choisir une prestation</option>
											for _, item := range page.CatalogItems {
												<option value={ item.ID } selected?={ item.ID == page.CatalogItemValue }>{ item.Name } · { strconv.Itoa(item.Duration) } min · { catalogPriceLabel(item.Price) }</option>
											}
										</select>
										if page.HasError(FieldCatalogItem) {
											<span class="text-error text-xs">{ page.Error(FieldCatalogItem) }</span>
										}
									</label>
									<button type="submit" class="btn min-h-11">Rendre réservable</button>
								</form>
							}
						}
					</div>
					<div class="divider my-0"></div>
					<div class="grid gap-3">
						<h3 class="text-sm font-semibold">Besoins par prestation</h3>
						if len(page.Services) == 0 {
							<p class="text-sm opacity-60">Aucune prestation de planning active. Ajoutez d’abord les prestations proposées par ce site.</p>
						} else {
							<ul class="grid gap-3">
								for _, service := range page.Services {
									<li class="grid gap-2 rounded-box border border-base-300 p-3">
										<div class="flex flex-wrap items-baseline justify-between gap-2">
											<span class="text-sm font-medium">{ service.Name }</span>
											<span class="text-xs opacity-60">{ strconv.Itoa(service.Duration) } min</span>
										</div>
										if len(service.Requirements) == 0 {
											<span class="text-xs opacity-60">Sélection manuelle des ressources</span>
										} else {
											<ul class="flex flex-wrap gap-2">
												for _, requirement := range service.Requirements {
													<li class="badge badge-outline h-auto gap-2 py-2">
														{ strconv.Itoa(requirement.Quantity) } × { resourceKindLabel(requirement.Kind) }
														if page.CanManage {
															<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/requirements/delete") }>
																<input type="hidden" name={ FieldRequirementService } value={ service.ID }/>
																<input type="hidden" name={ FieldRequirementKind } value={ requirement.Kind }/>
																<button type="submit" class="btn btn-ghost btn-xs min-h-11 min-w-11" aria-label={ "Retirer " + resourceKindLabel(requirement.Kind) + " de " + service.Name } formnovalidate>×</button>
															</form>
														}
													</li>
												}
											</ul>
										}
									</li>
								}
							</ul>
							if page.CanManage {
								<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/requirements") } class="grid gap-3 sm:grid-cols-[2fr_1fr_6rem_auto] sm:items-end" novalidate>
									<label class="form-control grid gap-1">
										<span class="label-text text-sm font-medium">Prestation</span>
										<select name={ FieldRequirementService } class={ "select min-h-11 w-full", templ.KV("select-error", page.HasError(FieldRequirementService)) }>
											<option value="">Choisir</option>
											for _, service := range page.Services {
												if service.Active {
													<option value={ service.ID } selected?={ service.ID == page.RequirementValues.ServiceID }>{ service.Name }</option>
												}
											}
										</select>
										if page.HasError(FieldRequirementService) {
											<span class="text-error text-xs">{ page.Error(FieldRequirementService) }</span>
										}
									</label>
									<label class="form-control grid gap-1">
										<span class="label-text text-sm font-medium">Type</span>
										<select name={ FieldRequirementKind } class={ "select min-h-11 w-full", templ.KV("select-error", page.HasError(FieldRequirementKind)) }>
											for _, kind := range resourceKindOptions {
												<option value={ kind.Value } selected?={ kind.Value == page.RequirementValues.Kind }>{ kind.Label }</option>
											}
										</select>
										if page.HasError(FieldRequirementKind) {
											<span class="text-error text-xs">{ page.Error(FieldRequirementKind) }</span>
										}
									</label>
									<label class="form-control grid gap-1">
										<span class="label-text text-sm font-medium">Quantité</span>
										<input type="number" name={ FieldRequirementQuantity } value={ strconv.Itoa(page.RequirementValues.Quantity) } min="1" max="10" class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldRequirementQuantity)) } required/>
										if page.HasError(FieldRequirementQuantity) {
											<span class="text-error text-xs">{ page.Error(FieldRequirementQuantity) }</span>
										}
									</label>
									<button type="submit" class="btn min-h-11">Enregistrer</button>
								</form>
							}
						}
					</div>
				</div>
			</section>
			<section class="card card-border border-base-300 bg-base-100" aria-labelledby="closures-heading">
				<div class="card-body gap-4 p-5">
					<div class="grid gap-1">
						<h2 id="closures-heading" class="text-base font-semibold">Fermetures exceptionnelles</h2>
						<p class="text-sm opacity-70">Jours fériés, réunion, congés ou fermeture ponctuelle de tout l’atelier.</p>
					</div>
					if len(page.Closures) == 0 {
						<p class="text-sm opacity-60">Aucune fermeture à venir.</p>
					} else {
						<ul class="grid gap-2">
							for _, closure := range page.Closures {
								<li class="flex flex-col gap-2 rounded-box border border-base-300 p-3 sm:flex-row sm:items-center sm:justify-between">
									<div class="grid gap-1">
										<span class="text-sm font-medium">{ closurePeriod(closure) }</span>
										if closure.Reason != "" {
											<span class="text-sm opacity-60">{ closure.Reason }</span>
										}
									</div>
									if page.CanManage {
										<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/closures/" + closure.ID + "/delete") } data-confirm={ "Retirer la fermeture « " + closurePeriod(closure) + " » ?" }>
											<button type="submit" class="btn btn-ghost btn-sm min-h-11 sm:min-h-9">Retirer</button>
										</form>
									}
								</li>
							}
						</ul>
					}
					if page.CanManage {
						<form method="post" action={ templ.URL("/locations/" + page.Location.ID + "/schedule/closures") } class="grid gap-3" novalidate>
							<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
								@dateField(FieldClosureStartDate, "Date de début", page.ClosureValues.StartsDate, page.Error(FieldClosureStartDate))
								@timeField(FieldClosureStartTime, "Heure de début", page.ClosureValues.StartsTime, page.Error(FieldClosureStartTime))
								@dateField(FieldClosureEndDate, "Date de fin", page.ClosureValues.EndsDate, page.Error(FieldClosureEndDate))
								@timeField(FieldClosureEndTime, "Heure de fin", page.ClosureValues.EndsTime, page.Error(FieldClosureEndTime))
							</div>
							<label class="form-control grid gap-1">
								<span class="label-text text-sm font-medium">Motif <span class="font-normal opacity-60">(optionnel)</span></span>
								<input name={ FieldClosureReason } value={ page.ClosureValues.Reason } maxlength="300" class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldClosureReason)) }/>
								if page.HasError(FieldClosureReason) {
									<span class="text-error text-xs">{ page.Error(FieldClosureReason) }</span>
								}
							</label>
							<button type="submit" class="btn btn-primary min-h-11 w-full sm:w-auto">Ajouter la fermeture</button>
						</form>
					}
				</div>
			</section>
		</div>
	}
}

templ timeField(name string, label string, value string, fieldError string) {
	<label class="form-control grid gap-1">
		<span class="label-text text-sm font-medium">{ label }</span>
		<input type="time" name={ name } value={ value } class={ "input min-h-11 w-full", templ.KV("input-error", fieldError != "") } required/>
		if fieldError != "" {
			<span class="text-error text-xs">{ fieldError }</span>
		}
	</label>
}

templ dateField(name string, label string, value string, fieldError string) {
	<label class="form-control grid gap-1">
		<span class="label-text text-sm font-medium">{ label }</span>
		<input type="date" name={ name } value={ value } class={ "input min-h-11 w-full", templ.KV("input-error", fieldError != "") } required/>
		if fieldError != "" {
			<span class="text-error text-xs">{ fieldError }</span>
		}
	</label>
}

// calendarSection lets a manager connect or disconnect this site's Google
// Calendar. Its own bordered block, same pattern as lifecycleSection: the
// action is destructive/security-sensitive enough to deserve a separate form
// and a clear yes/no state, not a checkbox buried in the identity form.
templ calendarSection(page FormPage) {
	<section class="card card-border border-base-300 bg-base-100" aria-labelledby="calendar-heading">
		<div class="card-body gap-3 p-5">
			<h2 id="calendar-heading" class="text-base font-semibold">Google Calendar</h2>
			if page.CalendarConnected {
				<p class="text-sm opacity-70">
					if page.CalendarAccount != "" {
						Connecté à { page.CalendarAccount }.
					} else {
						Connecté.
					}
					Les rendez-vous de ce site sont envoyés vers ce calendrier.
				</p>
				<form method="post" action={ templ.URL("/locations/" + page.ID + "/calendar/disconnect") } data-pending-form data-confirm="Déconnecter Google Calendar ? Les nouveaux rendez-vous ne seront plus synchronisés.">
					<button type="submit" class="btn btn-outline min-h-11 w-full sm:w-auto" data-pending-label="Déconnexion…">
						Déconnecter Google Calendar
					</button>
				</form>
			} else {
				<p class="text-sm opacity-70">
					Connectez un compte Google pour que les rendez-vous de ce site
					apparaissent automatiquement dans son calendrier.
				</p>
				<a href={ templ.URL("/locations/" + page.ID + "/calendar/connect") } class="btn min-h-11 w-full sm:w-auto">
					Connecter Google Calendar
				</a>
			}
		</div>
	</section>
}

// lifecycleSection keeps deactivation away from the save button: its own
// bordered block, outside the edit form, with its own wording.
templ lifecycleSection(page FormPage) {
	<section
		class={ "card card-border", templ.KV("border-error/40 bg-base-100", page.Active),
			templ.KV("border-base-300 bg-base-100", !page.Active) }
		aria-labelledby="lifecycle-heading"
	>
		<div class="card-body gap-3 p-5">
			<h2 id="lifecycle-heading" class="text-base font-semibold">
				if page.Active {
					Fermer ce site
				} else {
					Rouvrir ce site
				}
			</h2>
			if page.Active {
				<p class="text-sm opacity-70">
					Un site désactivé ne reçoit plus ni appels ni rendez-vous. Son historique
					reste consultable et vous pouvez le rouvrir quand vous voulez. Rien n'est
					supprimé.
				</p>
				<form method="post" action={ templ.URL("/locations/" + page.ID + "/deactivate") } data-pending-form data-confirm={ "Désactiver « " + page.Values.Name + " » ? Le site ne recevra plus d'appels ni de rendez-vous." }>
					<button type="submit" class="btn btn-error btn-outline min-h-11 w-full sm:w-auto" data-pending-label="Désactivation…">
						Désactiver ce site
					</button>
				</form>
			} else {
				<p class="text-sm opacity-70">
					Ce site est fermé. Le rouvrir lui rend les appels et les rendez-vous.
				</p>
				<form method="post" action={ templ.URL("/locations/" + page.ID + "/reactivate") } data-pending-form>
					<button type="submit" class="btn min-h-11 w-full sm:w-auto" data-pending-label="Réouverture…">
						Réactiver ce site
					</button>
				</form>
			}
		</div>
	</section>
}

// readOnlyLocation is what a member without management rights sees: the same
// information, presented as facts instead of disabled controls.
templ readOnlyLocation(page FormPage) {
	<div class="grid gap-4">
		<div role="status" class="alert items-start text-left">
			@infoIcon()
			<span class="text-sm">
				Vous consultez ce site en lecture seule. Seul un propriétaire de l'espace
				peut le modifier.
			</span>
		</div>
		<div class="card card-border border-base-300 bg-base-100">
			<div class="card-body p-5">
				<dl class="grid gap-3 text-sm sm:grid-cols-2">
					@readOnlyRow("Nom du site", page.Values.Name, true)
					@readOnlyRow("SIRET", page.Values.SIRET, false)
					@readOnlyRow("Téléphone", page.Values.PhoneE164, false)
					@readOnlyRow("Adresse", page.Values.AddressLine1, true)
					@readOnlyRow("Complément d'adresse", page.Values.AddressLine2, true)
					@readOnlyRow("Code postal", page.Values.PostalCode, false)
					@readOnlyRow("Ville", page.Values.City, false)
					@readOnlyRow("Pays", page.Values.CountryCode, false)
					@readOnlyRow("Fuseau horaire", page.Values.Timezone, false)
					@readOnlyRow("E-mail", page.Values.Email, false)
					@readOnlyRow("Site web", page.Values.WebsiteURL, true)
				</dl>
			</div>
		</div>
	</div>
}

templ readOnlyRow(label string, value string, wide bool) {
	<div class={ templ.KV("sm:col-span-2", wide) }>
		<dt class="text-xs opacity-60">{ label }</dt>
		<dd>
			if value == "" {
				<span class="opacity-60">Non renseigné</span>
			} else {
				{ value }
			}
		</dd>
	</div>
}

// field wraps one control with its label, its required/optional marker, its
// hint and its inline error. The ids match what describedBy builds.
templ field(page FormPage, key string, label string, required bool, hint string, wide bool) {
	<div class={ "grid content-start gap-1", templ.KV("sm:col-span-2", wide) }>
		<label class="label flex-wrap justify-start gap-2 font-medium text-base-content" for={ key }>
			{ label }
			if required {
				<span class="text-xs font-normal opacity-60">Requis</span>
			} else {
				<span class="text-xs font-normal opacity-60">Optionnel</span>
			}
		</label>
		{ children... }
		if hint != "" {
			<p id={ key + "-hint" } class="label text-xs leading-snug whitespace-normal">{ hint }</p>
		}
		if page.HasError(key) {
			<p id={ key + "-error" } role="alert" class="label text-xs leading-snug font-medium whitespace-normal text-error">
				{ page.Error(key) }
			</p>
		}
	</div>
}

// notice reports a server-side outcome. An icon and a heading carry the
// meaning, so no state depends on colour alone.
templ notice(n Notice) {
	if !n.Empty() {
		<div role="alert" class={ "alert items-start text-left", noticeColor(n.Kind) }>
			if n.Kind == NoticeSuccess {
				@successIcon()
			} else {
				@warningIcon()
			}
			<div class="grid gap-1">
				<span class="font-semibold">{ noticeTitle(n.Kind) }</span>
				<span class="text-sm">{ n.Message }</span>
			</div>
		</div>
	}
}

templ warningIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"></path>
	</svg>
}

templ successIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
	</svg>
}

templ infoIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"></path>
	</svg>
}

templ pendingScript() {
	<script>
		document.querySelectorAll("[data-pending-form]").forEach(function (form) {
			form.addEventListener("submit", function (event) {
				var button = event.submitter;
				if (!button || !button.dataset.pendingLabel) {
					return;
				}
				var label = button.dataset.pendingLabel;
				// Disabling synchronously here would drop the submitter's own
				// name/value from the request the browser is about to send -
				// defer one tick so submission happens first.
				setTimeout(function () {
					button.disabled = true;
					button.innerHTML = '<span class="loading loading-spinner loading-sm"></span>' + label;
				}, 0);
			});
		});
	</script>
}
