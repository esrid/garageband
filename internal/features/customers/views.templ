package customers

import "github.com/esrid/garageband/internal/ui"

// Interface copy is French; identifiers and comments stay English.

// Index is the customer search screen and its results.
templ Index(page Page) {
	@ui.Layout(ui.PageInfo{
		Title:   "Clients",
		NoIndex: true,
		Nav:     ui.Nav{Section: ui.SectionCustomers, Workspace: page.Organization, InWorkspace: true},
	}) {
		<div class="grid gap-5">
			<header class="grid gap-1">
				<h1 class="text-xl font-semibold">Clients</h1>
				<p class="text-sm opacity-70">
					Cherchez par nom, téléphone, e-mail, plaque ou numéro VIN.
				</p>
			</header>
			@notice(page.Notice)
			<search>
				<form method="get" action="/customers" class="flex flex-col gap-2 sm:flex-row" data-pending-form up-submit>
					<input type="hidden" name={ FieldNext } value={ page.Next }/>
					<div class="grid flex-1 gap-1">
						<label class="sr-only" for={ FieldQuery }>Rechercher un client</label>
						<input
							id={ FieldQuery }
							name={ FieldQuery }
							type="search"
							class="input min-h-11 w-full"
							value={ page.Query }
							placeholder="Nom, téléphone, plaque…"
							autocomplete="off"
							aria-describedby="search-hint"
						/>
					</div>
					<button type="submit" class="btn btn-primary min-h-11 sm:w-auto" data-pending-label="Recherche…">
						Rechercher
					</button>
				</form>
				<p id="search-hint" class="mt-1 text-xs opacity-60">
					Une plaque se cherche avec ou sans tirets.
				</p>
			</search>
			@createDisclosure(page)
			if !page.Searched() {
				<div class="card card-border border-base-300 bg-base-100">
					<div class="card-body items-start gap-2 p-5">
						<h2 class="text-base font-semibold">Trouvez un client</h2>
						<p class="text-sm opacity-70">
							Tapez ce que vous avez sous la main : le nom au téléphone, la plaque
							du véhicule sur le parking, ou le numéro qui vient d'appeler.
						</p>
					</div>
				</div>
			} else if len(page.Customers) == 0 {
				<div class="card card-border border-base-300 bg-base-100">
					<div class="card-body items-start gap-2 p-5">
						<h2 class="text-base font-semibold">Aucun résultat pour « { page.Query } »</h2>
						<p class="text-sm opacity-70">
							Vérifiez l'orthographe, ou essayez la plaque plutôt que le nom. Un
							client créé par un autre site n'apparaît que s'il vous a été partagé.
						</p>
					</div>
				</div>
			} else {
				<div class="grid gap-3">
					<p role="status" class="text-sm opacity-70">{ ResultSummary(len(page.Customers)) }</p>
					<ul class="grid gap-3">
						for _, customer := range page.Customers {
							<li>
								@customerCard(customer, page.Next)
							</li>
						}
					</ul>
				</div>
			}
		</div>
		@pendingScript()
	}
}

// createDisclosure is the quick-create form, collapsed by default behind a
// native <details> - no JS needed for the show/hide itself. It stays open
// after a failed submission so the visitor doesn't lose what they typed.
templ createDisclosure(page Page) {
	<details class="card card-border border-base-300 bg-base-100" open?={ page.CreateOpen }>
		<summary class="cursor-pointer p-5 text-sm font-semibold">+ Nouveau client</summary>
		<div class="card-body gap-4 p-5 pt-0">
			<form method="post" action="/customers" class="grid gap-4 sm:grid-cols-2" data-pending-form up-submit>
				<input type="hidden" name={ FieldQuery } value={ page.Query }/>
				<input type="hidden" name={ FieldNext } value={ page.Next }/>
				<div class="grid gap-1">
					<label class="label font-medium text-base-content" for={ FieldNewLastName }>Nom</label>
					<input
						id={ FieldNewLastName }
						name={ FieldNewLastName }
						class={ "input min-h-11 w-full", templ.KV("input-error", page.HasCreateError(FieldNewLastName)) }
						value={ page.CreateValues.LastName }
						aria-invalid={ ariaInvalid(page.HasCreateError(FieldNewLastName)) }
						required
					/>
					if page.HasCreateError(FieldNewLastName) {
						<p role="alert" class="label text-xs font-medium text-error">{ page.CreateError(FieldNewLastName) }</p>
					}
				</div>
				<div class="grid gap-1">
					<label class="label font-medium text-base-content" for={ FieldNewFirstName }>Prénom</label>
					<input
						id={ FieldNewFirstName }
						name={ FieldNewFirstName }
						class="input min-h-11 w-full"
						value={ page.CreateValues.FirstName }
					/>
				</div>
				<div class="grid gap-1">
					<label class="label font-medium text-base-content" for={ FieldNewPhone }>Téléphone</label>
					<input
						id={ FieldNewPhone }
						name={ FieldNewPhone }
						type="tel"
						class={ "input min-h-11 w-full", templ.KV("input-error", page.HasCreateError(FieldNewPhone)) }
						value={ page.CreateValues.Phone }
						aria-invalid={ ariaInvalid(page.HasCreateError(FieldNewPhone)) }
					/>
					if page.HasCreateError(FieldNewPhone) {
						<p role="alert" class="label text-xs font-medium text-error">{ page.CreateError(FieldNewPhone) }</p>
					}
				</div>
				<div class="grid gap-1">
					<label class="label font-medium text-base-content" for={ FieldNewPlate }>Plaque d'immatriculation</label>
					<input
						id={ FieldNewPlate }
						name={ FieldNewPlate }
						class={ "input min-h-11 w-full", templ.KV("input-error", page.HasCreateError(FieldNewPlate)) }
						value={ page.CreateValues.Plate }
						aria-invalid={ ariaInvalid(page.HasCreateError(FieldNewPlate)) }
						required
					/>
					if page.HasCreateError(FieldNewPlate) {
						<p role="alert" class="label text-xs font-medium text-error">{ page.CreateError(FieldNewPlate) }</p>
					}
				</div>
				<div class="sm:col-span-2">
					<button type="submit" class="btn btn-primary min-h-11" data-pending-label="Création…">Créer le client</button>
				</div>
			</form>
		</div>
	</details>
}

// customerCard leads with the name, then the way to reach them, then what they
// drive — the order a garage actually needs when the phone is ringing. In a
// booking flow (next != "") the name jumps back into it with this customer
// chosen, instead of opening their dossier.
templ customerCard(customer Customer, next string) {
	<article class="card card-border border-base-300 bg-base-100">
		<div class="card-body gap-2 p-5">
			<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
				<h2 class="text-base font-semibold">
					if next != "" {
						<a href={ templ.URL(NextTarget(next, customer.ID)) } up-follow class="link-hover link">
							{ customer.Label() }
						</a>
					} else {
						<a href={ templ.URL(customerPath(customer)) } class="link-hover link">
							{ customer.Label() }
						</a>
					}
				</h2>
				if customer.Shared {
					<span class="badge badge-sm shrink-0">Partagé avec vous</span>
				}
			</div>
			if len(customer.Contacts()) > 0 {
				<p class="text-sm opacity-80">
					for index, contact := range customer.Contacts() {
						if index > 0 {
							<span class="opacity-50" aria-hidden="true">{ " · " }</span>
						}
						{ contact }
					}
				</p>
			} else {
				<p class="text-sm opacity-60">Aucun contact enregistré</p>
			}
			if len(customer.Vehicles) > 0 {
				<p class="text-xs opacity-60">{ vehicleSummary(customer.Vehicles) }</p>
			} else {
				<p class="text-xs opacity-60">Aucun véhicule enregistré</p>
			}
			if customer.HomeLocationName != "" {
				<p class="text-xs opacity-60">
					<span class="opacity-70">Site :</span> { customer.HomeLocationName }
				</p>
			}
		</div>
	</article>
}

// notice reports a server-side outcome. An icon and a heading carry the
// meaning, so no state depends on colour alone.
templ notice(n Notice) {
	if !n.Empty() && n.Kind == NoticeSuccess {
		<div role="status" class="alert items-start text-left alert-success">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
			<span class="text-sm">{ n.Message }</span>
		</div>
	} else if !n.Empty() {
		<div role="alert" class="alert items-start text-left alert-warning">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"></path>
			</svg>
			<div class="grid gap-1">
				<span class="font-semibold">Action impossible pour le moment</span>
				<span class="text-sm">{ n.Message }</span>
			</div>
		</div>
	}
}

templ pendingScript() {
	<script>
		document.querySelectorAll("[data-pending-form]").forEach(function (form) {
			form.addEventListener("submit", function () {
				var button = form.querySelector("[data-pending-label]");
				if (!button) {
					return;
				}
				button.disabled = true;
				button.innerHTML =
					'<span class="loading loading-spinner loading-sm"></span>' +
					button.dataset.pendingLabel;
			});
		});
	</script>
}

// Show is the customer profile: who they are, what they drive, and everything
// that happened, newest first.
templ Show(page Profile) {
	@ui.Layout(ui.PageInfo{
		Title:   page.Customer.Label(),
		NoIndex: true,
		Nav:     ui.Nav{Section: ui.SectionCustomers, Workspace: page.Organization, InWorkspace: true},
	}) {
		<div class="grid gap-5">
			<nav aria-label="Fil d'Ariane" class="text-sm">
				<a href="/customers" class="link">Clients</a>
			</nav>
			<header class="grid gap-2">
				<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<h1 class="text-xl font-semibold">{ page.Customer.Label() }</h1>
						if page.Customer.Shared {
							<span class="badge badge-sm shrink-0">Partagé avec vous</span>
						}
					</div>
					<a href={ templ.URL("/agenda/new?customer_id=" + page.Customer.ID) } class="btn btn-primary btn-sm min-h-11 shrink-0">
						Nouveau rendez-vous
					</a>
				</div>
				if len(page.Customer.Contacts()) > 0 {
					<p class="text-sm opacity-80">
						for index, contact := range page.Customer.Contacts() {
							if index > 0 {
								<span class="opacity-50" aria-hidden="true">{ " · " }</span>
							}
							{ contact }
						}
					</p>
				}
				if page.Customer.HomeLocationName != "" {
					<p class="text-xs opacity-60">
						<span class="opacity-70">Site d'origine :</span> { page.Customer.HomeLocationName }
					</p>
				}
			</header>
			@notice(page.Notice)
			if !page.CanEdit {
				<div role="status" class="alert items-start text-left">
					@infoIcon()
					<div class="grid gap-1">
						<span class="font-semibold">Dossier partagé, en lecture</span>
						<span class="text-sm">
							Ce client appartient à un autre site. Vous voyez tout son dossier et
							vous pouvez y ajouter votre propre travail, mais son identité, ses
							véhicules et les interventions des autres sites ne se modifient pas
							ici.
						</span>
					</div>
				</div>
			}
			<section class="grid gap-3" aria-labelledby="vehicles-heading">
				<h2 id="vehicles-heading" class="text-base font-semibold">Véhicules</h2>
				if len(page.Vehicles) == 0 {
					<p class="text-sm opacity-60">Aucun véhicule enregistré pour ce client.</p>
				} else {
					<ul class="grid gap-2">
						for _, vehicle := range page.Vehicles {
							<li class="card card-border border-base-300 bg-base-100">
								<div class="card-body gap-1 p-4">
									<p class="font-mono text-sm font-medium">
										if vehicle.Plate != "" {
											{ vehicle.Plate }
										} else {
											Plaque inconnue
										}
									</p>
									<p class="text-sm opacity-80">{ vehicle.Label() }</p>
									if vehicle.VIN != "" {
										<p class="font-mono text-xs opacity-60">VIN { vehicle.VIN }</p>
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>
			<section class="grid gap-3" aria-labelledby="timeline-heading">
				<h2 id="timeline-heading" class="text-base font-semibold">Historique</h2>
				if len(page.Timeline) == 0 {
					<p class="text-sm opacity-60">
						Aucun rendez-vous ni réparation pour l'instant.
					</p>
				} else {
					<ul class="grid gap-2">
						for _, event := range page.Timeline {
							<li>
								@timelineEvent(event)
							</li>
						}
					</ul>
				}
			</section>
			if len(page.Memories) > 0 {
				<section class="grid gap-3" aria-labelledby="memories-heading">
					<h2 id="memories-heading" class="text-base font-semibold">Ce que l'agent a retenu</h2>
					<p class="text-sm opacity-70">
						Informations notées pendant les appels. À vérifier avant de s'en servir.
					</p>
					<ul class="grid gap-2">
						for _, memory := range page.Memories {
							<li class="card card-border border-base-300 bg-base-100">
								<div class="card-body gap-1 p-4">
									<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
										<p class="text-sm font-medium">{ memory.Key }</p>
										<span class="badge badge-sm shrink-0">{ memoryStatusLabel(memory.Status) }</span>
									</div>
									<p class="text-sm opacity-80">{ memory.Value }</p>
									if confidenceLabel(memory.Confidence) != "" {
										<p class="text-xs opacity-60">{ confidenceLabel(memory.Confidence) }</p>
									}
								</div>
							</li>
						}
					</ul>
				</section>
			}
			if page.CanManage {
				<section class="grid gap-3" aria-labelledby="sharing-heading">
					<h2 id="sharing-heading" class="text-base font-semibold">Partage entre sites</h2>
					if len(page.Grants) == 0 {
						<p class="text-sm opacity-60">Ce dossier n'a jamais été partagé.</p>
					} else {
						<ul class="grid gap-2">
							for _, grant := range page.Grants {
								<li class="card card-border border-base-300 bg-base-100">
									<div class="card-body gap-1 p-4">
										<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
											<p class="text-sm font-medium">{ grant.ReceivingLocationName }</p>
											if grant.Active() {
												<span class="badge badge-sm badge-success shrink-0">Actif</span>
											} else {
												<span class="badge badge-sm shrink-0">Révoqué</span>
											}
										</div>
										<p class="text-xs opacity-60">
											Partagé par { grant.GrantedByName } le { ui.FormatDate(grant.GrantedAt) }
										</p>
										if !grant.Active() {
											<p class="text-xs opacity-60">
												Révoqué par { grant.RevokedByName } le { ui.FormatDate(*grant.RevokedAt) }
											</p>
										} else {
											<form method="post" action={ templ.SafeURL("/customers/" + page.Customer.ID + "/shares/" + grant.ID + "/revoke") }>
												<button type="submit" class="btn btn-sm btn-outline">Révoquer</button>
											</form>
										}
									</div>
								</li>
							}
						</ul>
					}
					if len(page.ShareOptions) > 0 {
						<form method="post" action={ templ.SafeURL("/customers/" + page.Customer.ID + "/shares") } class="flex flex-wrap items-end gap-2" data-pending-form>
							<div class="grid gap-1">
								<label class="text-sm" for={ FieldReceivingLocation }>Partager avec</label>
								<select id={ FieldReceivingLocation } name={ FieldReceivingLocation } class="select min-h-11">
									for _, option := range page.ShareOptions {
										<option value={ option.ID }>{ option.Name }</option>
									}
								</select>
							</div>
							<button type="submit" class="btn btn-sm min-h-11" data-pending-label="Partage…">Partager</button>
						</form>
					}
				</section>
				<section class="grid gap-2" aria-labelledby="offboard-heading">
					<h2 id="offboard-heading" class="text-base font-semibold">Zone sensible</h2>
					<div class="card card-border border-error/30 bg-base-100">
						<div class="card-body gap-2 p-4">
							<p class="text-sm opacity-80">
								Ce client est parti : son dossier reste consultable pour l'historique,
								mais son téléphone et son e-mail se libèrent pour un nouveau client.
							</p>
							<form method="post" action={ templ.SafeURL("/customers/" + page.Customer.ID + "/offboard") } class="self-start">
								<button type="submit" class="btn btn-sm btn-error btn-outline">Ce client est parti</button>
							</form>
						</div>
					</div>
				</section>
			}
		</div>
	}
}

// timelineEvent is one appointment or repair. It names the workshop that wrote
// it, because on a shared dossier that decides what you may touch.
templ timelineEvent(event Event) {
	<article class="card card-border border-base-300 bg-base-100">
		<div class="card-body gap-1 p-4">
			<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
				<p class="text-sm font-medium">{ eventTitle(event) }</p>
				<span class="badge badge-sm shrink-0">{ eventStatusLabel(event) }</span>
			</div>
			<p class="text-xs opacity-70">
				{ eventKindLabel(event.Kind) }
				<span class="opacity-50" aria-hidden="true">{ " · " }</span>
				{ ui.FormatDate(event.At) }
				if event.VehicleLabel != "" {
					<span class="opacity-50" aria-hidden="true">{ " · " }</span>
					{ event.VehicleLabel }
				}
			</p>
			<div class="flex flex-wrap items-baseline justify-between gap-x-3">
				<p class="text-xs opacity-60">
					{ event.LocationName }
					if !event.AuthoredHere {
						<span class="opacity-50" aria-hidden="true">{ " · " }</span>
						<span>Autre site, en lecture</span>
					}
				</p>
				if formatAmount(event.AmountCents, event.Currency) != "" {
					<p class="text-sm font-medium">{ formatAmount(event.AmountCents, event.Currency) }</p>
				}
			</div>
		</div>
	</article>
}

templ infoIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"></path>
	</svg>
}
