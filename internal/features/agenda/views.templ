package agenda

import (
	"strconv"

	"github.com/esrid/garageband/internal/ui"
)

// Interface copy is French; identifiers and comments stay English.

var pendingHandle = templ.NewOnceHandle()

// Show is one workshop day, in order.
templ Show(page Day) {
	@ui.Layout(ui.PageInfo{
		Title:   "Agenda",
		NoIndex: true,
		Nav:     ui.Nav{Section: ui.SectionAgenda, Workspace: page.Organization, InWorkspace: true},
	}) {
		<div class="grid gap-5">
			<header class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
				<div class="grid gap-1">
				<h1 class="text-xl font-semibold">{ ui.FormatDayHeading(page.Date) }</h1>
				<p class="text-sm opacity-70">
					{ page.LocationName }
					<span class="opacity-50" aria-hidden="true">{ " · " }</span>
					{ bookedSummary(page.Booked()) }
				</p>
				</div>
				if len(page.Locations) > 1 {
					<form method="get" action="/agenda" class="grid gap-1">
						<label for="agenda-location" class="text-xs font-medium opacity-70">Établissement</label>
						<input type="hidden" name="date" value={ page.DateValue() }/>
						<select id="agenda-location" name={ FieldLocation } class="select select-sm min-h-11" onchange="this.form.submit()">
							for _, option := range page.Locations {
								<option value={ option.Value } selected?={ option.Value == page.LocationID }>{ option.Label }</option>
							}
						</select>
					</form>
				}
			</header>
			@notice(page.Notice)
			@remindersDue(page)
			<nav aria-label="Changer de jour" class="flex flex-wrap items-center gap-2">
				<a href={ templ.URL(page.Path(page.PreviousDate())) } class="btn btn-sm min-h-11">
					<span aria-hidden="true">←</span> Veille
				</a>
				<a href={ templ.URL(page.Path(page.NextDate())) } class="btn btn-sm min-h-11">
					Lendemain <span aria-hidden="true">→</span>
				</a>
				<a href={ templ.URL(page.WeekViewPath()) } class="btn btn-ghost btn-sm min-h-11">Vue semaine</a>
				<form method="get" action="/agenda" class="flex items-center gap-2">
					<input type="hidden" name={ FieldLocation } value={ page.LocationID }/>
					<label class="sr-only" for="date-jump">Aller à une date</label>
					<input
						id="date-jump"
						name="date"
						type="date"
						class="input input-sm min-h-11"
						value={ page.DateValue() }
					/>
					<button type="submit" class="btn btn-sm min-h-11">Aller</button>
				</form>
				if page.CanManage {
					<a href={ templ.URL(page.NewPath()) } up-layer="new" class="btn btn-primary btn-sm min-h-11 sm:ml-auto">
						Nouveau rendez-vous
					</a>
				}
			</nav>
			if len(page.Appointments) == 0 {
				<div class="card card-border border-base-300 bg-base-100">
					<div class="card-body items-start gap-2 p-5">
						<h2 class="text-base font-semibold">Journée libre</h2>
						<p class="text-sm opacity-70">
							Aucun rendez-vous ce jour-là. Les rendez-vous pris par l'agent
							téléphonique apparaissent ici automatiquement.
						</p>
					</div>
				</div>
			} else {
				<ul class="grid gap-2">
					for _, appointment := range page.Appointments {
						<li>
							@appointmentRow(appointment, page.CanManage)
						</li>
					}
				</ul>
			}
		</div>
		@pendingHandle.Once() {
			@pendingScript()
		}
	}
}

// remindersDue is the work queue of appointments starting soon that nobody
// has reached out about yet - manual (no telephony integration exists in
// this codebase), so each row is a phone number to call and a button to
// mark done once it's been called.
templ remindersDue(page Day) {
	if len(page.RemindersDue) > 0 {
		<section class="card card-border border-warning/50 bg-warning/10" aria-labelledby="reminders-heading">
			<div class="card-body gap-3 p-5">
				<h2 id="reminders-heading" class="text-base font-semibold">Rappels à faire</h2>
				<p class="text-sm opacity-70">
					Ces rendez-vous approchent et le client n'a pas encore été relancé.
				</p>
				<ul class="grid gap-2">
					for _, reminder := range page.RemindersDue {
						<li class="flex flex-wrap items-center justify-between gap-2 rounded-btn bg-base-100 p-3">
							<div class="grid gap-0.5">
								<p class="text-sm font-medium">
									{ reminder.CustomerName }
									<span class="opacity-50" aria-hidden="true">{ " · " }</span>
									{ ui.FormatDate(reminder.StartsAt) } à { ui.FormatTime(reminder.StartsAt) }
								</p>
								<p class="text-xs opacity-70">
									if reminder.Phone != "" {
										{ reminder.Phone }
									} else {
										Aucun téléphone enregistré
									}
									if reminder.ServiceName != "" {
										<span class="opacity-50" aria-hidden="true">{ " · " }</span>
										{ reminder.ServiceName }
									}
								</p>
							</div>
							<form method="post" action={ templ.URL(remindPath(reminder.AppointmentID)) } data-pending-form>
								<button type="submit" class="btn btn-sm min-h-11" data-pending-label="Enregistrement…">
									Marquer comme rappelé
								</button>
							</form>
						</li>
					}
				</ul>
			</div>
		</section>
	}
}

// ShowWeek is the workshop's week as a grid: days as columns, time of day as
// rows — the overview a single day list can't give at a glance. Built with
// plain CSS grid (native platform feature, no charting/scheduling
// dependency): each appointment is one grid item, positioned by
// Week.GridRowStyle.
templ ShowWeek(page Week) {
	@ui.Layout(ui.PageInfo{
		Title:   "Agenda de la semaine",
		NoIndex: true,
		Nav:     ui.Nav{Section: ui.SectionAgenda, Workspace: page.Organization, InWorkspace: true},
		Wide:    true,
	}) {
		<div class="grid gap-5">
			<header class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
				<div class="grid gap-1">
					<h1 class="text-xl font-semibold">
						Semaine du { ui.FormatDate(page.WeekStart) } au { ui.FormatDate(page.Days()[6]) }
					</h1>
					<p class="text-sm opacity-70">{ page.LocationName }</p>
				</div>
				if len(page.Locations) > 1 {
					<form method="get" action="/agenda/week" class="grid gap-1">
						<label for="agenda-week-location" class="text-xs font-medium opacity-70">Établissement</label>
						<input type="hidden" name="date" value={ page.WeekStart.Format(DateLayout) }/>
						<select id="agenda-week-location" name={ FieldLocation } class="select select-sm min-h-11" onchange="this.form.submit()">
							for _, option := range page.Locations {
								<option value={ option.Value } selected?={ option.Value == page.LocationID }>{ option.Label }</option>
							}
						</select>
					</form>
				}
			</header>
			@notice(page.Notice)
			<nav aria-label="Changer de semaine" class="flex flex-wrap items-center gap-2">
				<a href={ templ.URL(page.Path(page.PreviousWeek())) } class="btn btn-sm min-h-11">
					<span aria-hidden="true">←</span> Semaine précédente
				</a>
				<a href={ templ.URL(page.Path(page.NextWeek())) } class="btn btn-sm min-h-11">
					Semaine suivante <span aria-hidden="true">→</span>
				</a>
				<a href={ templ.URL(page.DayViewPath()) } class="btn btn-ghost btn-sm min-h-11">Vue jour</a>
				if page.CanManage {
					<a href={ templ.URL(page.NewPath()) } up-layer="new" class="btn btn-primary btn-sm min-h-11 sm:ml-auto">
						Nouveau rendez-vous
					</a>
				}
			</nav>
			<div class="overflow-x-auto">
				@weekGrid(page)
			</div>
		</div>
		@pendingHandle.Once() {
			@pendingScript()
		}
	}
}

// weekGrid renders the grid twice over: every half-hour cell is a real link
// (click an empty one to book at that exact time) and a drop target (data-date
// /data-start-time), and every appointment is a draggable link (plain click
// still edits it - HTML5 drag events don't hijack a normal click). Dragging
// resubmits the existing move form instead of duplicating the appointment's
// other fields into the DOM: see dragScript.
templ weekGrid(page Week) {
	{{ slotRows := "auto repeat(" + strconv.Itoa(page.SlotCount()) + ", 1.75rem)" }}
	<div
		id="week-grid"
		class="grid min-w-[720px] gap-px rounded-box border border-base-300 bg-base-300"
		style={ "grid-template-columns: 3.5rem repeat(7, 1fr); grid-template-rows: " + slotRows + ";" }
	>
		<div class="bg-base-100" style="grid-row: 1; grid-column: 1;"></div>
		for dayIndex, day := range page.Days() {
			<div class="bg-base-100 p-1 text-center text-xs font-medium" style={ "grid-row: 1; grid-column: " + strconv.Itoa(dayIndex+2) + ";" }>
				{ ui.FormatWeekdayShort(day) } { strconv.Itoa(day.Day()) }
			</div>
		}
		for slotIndex, label := range page.HourLabels() {
			<div
				class="bg-base-100 pr-1 text-right text-[0.65rem] leading-none opacity-60"
				style={ "grid-row: " + strconv.Itoa(slotIndex*2+2) + " / span 2; grid-column: 1;" }
			>
				{ label }
			</div>
		}
		for dayIndex, day := range page.Days() {
			for slotIndex, slotTime := range page.SlotStartTimes() {
				<a
					href={ templ.URL(page.NewPathAt(day, slotTime)) }
					up-layer="new"
					class="agenda-slot bg-base-100 transition-colors hover:bg-base-200"
					data-date={ day.Format(DateLayout) }
					data-start-time={ slotTime }
					aria-label={ "Nouveau rendez-vous, " + ui.FormatWeekdayShort(day) + " " + strconv.Itoa(day.Day()) + " à " + slotTime }
					style={ "grid-row: " + strconv.Itoa(slotIndex+2) + "; grid-column: " + strconv.Itoa(dayIndex+2) + ";" }
				></a>
			}
			for _, appointment := range page.AppointmentsOn(day) {
				<a
					href={ templ.URL(appointmentPath(appointment)) }
					up-layer="new"
					draggable="true"
					data-appointment-id={ appointment.ID }
					class={ "agenda-appointment m-px cursor-grab overflow-hidden rounded-sm px-1 py-0.5 text-left text-[0.65rem] leading-tight active:cursor-grabbing",
						templ.KV("bg-primary text-primary-content", appointment.Occupies()),
						templ.KV("bg-base-200 text-base-content/60 line-through", !appointment.Occupies()) }
					style={ page.GridRowStyle(appointment) + "; grid-column: " + strconv.Itoa(dayIndex+2) + ";" }
				>
					<span class="block font-medium">{ ui.FormatTime(appointment.StartsAt) } { appointment.CustomerName }</span>
					if appointment.ServiceName != "" {
						<span class="block opacity-80">{ appointment.ServiceName }</span>
					}
				</a>
			}
		}
	</div>
	<form id="agenda-move-form" method="post" class="hidden">
		<input type="hidden" name={ FieldLocation } value={ page.LocationID }/>
		<input type="hidden" name={ FieldDate }/>
		<input type="hidden" name={ FieldStartTime }/>
	</form>
	@dragScript()
}

// dragScript wires drag-and-drop on top of the grid built above. It only
// ever resubmits the existing move form with a new date/start_time -
// dropping is a real POST + full navigation, not a fetch call, so a
// successful move, a conflict, and every other outcome all go through the
// exact same server-rendered notice path every other write in this app
// already uses.
templ dragScript() {
	<script>
		(function () {
			var grid = document.getElementById("week-grid");
			var form = document.getElementById("agenda-move-form");
			if (!grid || !form) {
				return;
			}
			var dateInput = form.querySelector('[name="date"]');
			var startTimeInput = form.querySelector('[name="start_time"]');

			grid.querySelectorAll(".agenda-appointment").forEach(function (block) {
				block.addEventListener("dragstart", function (event) {
					event.dataTransfer.setData("text/plain", block.dataset.appointmentId);
					event.dataTransfer.effectAllowed = "move";
				});
			});

			grid.querySelectorAll(".agenda-slot").forEach(function (cell) {
				cell.addEventListener("dragover", function (event) {
					event.preventDefault();
					cell.classList.add("bg-primary/20");
				});
				cell.addEventListener("dragleave", function () {
					cell.classList.remove("bg-primary/20");
				});
				cell.addEventListener("drop", function (event) {
					event.preventDefault();
					cell.classList.remove("bg-primary/20");
					var appointmentID = event.dataTransfer.getData("text/plain");
					if (!appointmentID) {
						return;
					}
					form.action = "/agenda/" + appointmentID + "/move";
					dateInput.value = cell.dataset.date;
					startTimeInput.value = cell.dataset.startTime;
					form.submit();
				});
			});
		})();
	</script>
}

// appointmentRow puts the time first: on a day screen that is the column the
// eye follows.
templ appointmentRow(appointment Appointment, canManage bool) {
	<article
		class={ "card card-border border-base-300",
			templ.KV("bg-base-100", appointment.Occupies()),
			templ.KV("border-dashed bg-base-200", !appointment.Occupies()) }
	>
		<div class="card-body gap-2 p-4">
			<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
				<p class="font-mono text-sm font-medium">
					{ ui.FormatTimeRange(appointment.StartsAt, appointment.EndsAt) }
				</p>
				<span class="badge badge-sm shrink-0">{ statusLabel(appointment.Status) }</span>
			</div>
			<p class="text-base font-semibold">
				if appointment.CustomerID != "" {
					<a href={ templ.URL(customerPath(appointment)) } class="link-hover link">
						{ appointment.CustomerName }
					</a>
				} else {
					{ appointment.CustomerName }
				}
			</p>
			<p class="text-sm opacity-80">
				if appointment.ServiceName != "" {
					{ appointment.ServiceName }
				} else {
					Prestation à préciser
				}
				if appointment.VehicleLabel != "" {
					<span class="opacity-50" aria-hidden="true">{ " · " }</span>
					{ appointment.VehicleLabel }
				}
			</p>
			<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
				<p class="text-xs opacity-60">
					if appointment.ResourceName != "" {
						{ appointment.ResourceName }
					} else {
						Aucune ressource affectée
					}
					if sourceLabel(appointment.Source) != "" {
						<span class="opacity-50" aria-hidden="true">{ " · " }</span>
						{ sourceLabel(appointment.Source) }
					}
				</p>
				if canManage {
					<a href={ templ.URL(appointmentPath(appointment)) } up-layer="new" class="btn btn-ghost btn-sm min-h-11">
						Modifier<span class="sr-only">{ " le rendez-vous de " + appointment.CustomerName }</span>
					</a>
				}
			</div>
			if appointment.Note != "" {
				<p class="text-xs opacity-70">{ appointment.Note }</p>
			}
		</div>
	</article>
}

// Form books an appointment or edits one; both use the same screen.
templ Form(page FormPage) {
	@ui.Layout(ui.PageInfo{
		Title:   formTitle(page),
		NoIndex: true,
		Nav:     ui.Nav{Section: ui.SectionAgenda, Workspace: page.Organization, InWorkspace: true},
	}) {
		<div class="grid gap-5">
			<nav aria-label="Fil d'Ariane" class="text-sm">
				<a href={ templ.URL(agendaPath(page)) } class="link">Agenda</a>
			</nav>
			<header class="grid gap-1">
				<h1 class="text-xl font-semibold">{ formTitle(page) }</h1>
				<p class="text-sm opacity-70">{ page.LocationName }</p>
			</header>
			@notice(page.Notice)
			if !page.Ready() {
				<div class="card card-border border-base-300 bg-base-100">
					<div class="card-body items-start gap-2 p-5">
						<h2 class="text-base font-semibold">Choisissez d'abord un client</h2>
						<p class="text-sm opacity-70">
							Un rendez-vous se prend pour quelqu'un. Trouvez le client, ou
							créez-le, puis revenez ici.
						</p>
						<a href={ templ.URL(page.CustomerPickerPath()) } up-follow class="btn btn-primary mt-1 min-h-11">Chercher un client</a>
					</div>
				</div>
			} else {
				<form
					method="post"
					action={ templ.URL(formActionPath(page)) }
					class="grid gap-4"
					data-pending-form
					novalidate
					up-submit
					up-layer="parent"
					up-target="#main"
				>
					<input type="hidden" name={ FieldLocation } value={ page.LocationID }/>
					<input type="hidden" name={ FieldCustomer } value={ page.Customer.ID }/>
					<input type="hidden" name={ FieldView } value={ page.ReturnView }/>
					<section class="card card-border border-base-300 bg-base-100">
						<div class="card-body gap-4 p-5">
							<div class="grid gap-1">
								<h2 class="text-base font-semibold">Client</h2>
								<p class="text-sm">{ page.Customer.Label }</p>
								<p class="text-xs opacity-60">
									Pour changer de client, ouvrez sa fiche et repartez de là.
								</p>
							</div>
							if len(page.UpcomingAppointments) > 0 {
								<div class="rounded-btn border border-warning/50 bg-warning/10 p-2">
									<p class="text-xs font-semibold text-warning">
										{ upcomingAppointmentsSummary(page.UpcomingAppointmentCount) }
									</p>
									<ul class="mt-1 grid gap-0.5 text-xs">
										for _, appointment := range page.UpcomingAppointments {
											<li>
												{ ui.FormatDate(appointment.StartsAt) } à { ui.FormatTime(appointment.StartsAt) }
												if appointment.Reason != "" {
													<span class="opacity-70">{ " · " + appointment.Reason }</span>
												}
											</li>
										}
										if more := page.moreUpcomingAppointments(); more > 0 {
											<li class="opacity-70">{ "+" + strconv.Itoa(more) + " autre(s)" }</li>
										}
									</ul>
								</div>
							}
							@field(page, FieldVehicle, "Véhicule", true, "", false) {
								<select
									id={ FieldVehicle }
									name={ FieldVehicle }
									class={ "select min-h-11 w-full", templ.KV("select-error", page.HasError(FieldVehicle)) }
									aria-invalid={ ariaInvalid(page.HasError(FieldVehicle)) }
									aria-describedby={ describedBy(FieldVehicle, false, page.HasError(FieldVehicle)) }
									required
								>
									<option value="">Choisir un véhicule</option>
									for _, option := range page.Vehicles {
										<option value={ option.Value } selected?={ option.Value == page.Values.VehicleID }>{ option.Label }</option>
									}
								</select>
							}
							@field(page, FieldService, "Prestation", true, "La durée du rendez-vous en découle.", false) {
								<select
									id={ FieldService }
									name={ FieldService }
									class={ "select min-h-11 w-full", templ.KV("select-error", page.HasError(FieldService)) }
									aria-invalid={ ariaInvalid(page.HasError(FieldService)) }
									aria-describedby={ describedBy(FieldService, true, page.HasError(FieldService)) }
									required
								>
									<option value="">Choisir une prestation</option>
									for _, option := range page.Services {
										<option value={ option.Value } selected?={ option.Value == page.Values.ServiceID }>{ option.Label }</option>
									}
								</select>
							}
						</div>
					</section>
					<section class="card card-border border-base-300 bg-base-100">
						<div class="card-body gap-4 p-5">
							<h2 class="text-base font-semibold">Créneau</h2>
							<div class="grid gap-4 sm:grid-cols-2">
								@field(page, FieldDate, "Date", true, "", false) {
									<input
										id={ FieldDate }
										name={ FieldDate }
										type="date"
										class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldDate)) }
										value={ page.Values.Date }
										aria-invalid={ ariaInvalid(page.HasError(FieldDate)) }
										aria-describedby={ describedBy(FieldDate, false, page.HasError(FieldDate)) }
										required
									/>
								}
								@field(page, FieldStartTime, "Heure de début", true, "", false) {
									<input
										id={ FieldStartTime }
										name={ FieldStartTime }
										type="time"
										class={ "input min-h-11 w-full", templ.KV("input-error", page.HasError(FieldStartTime)) }
										value={ page.Values.StartTime }
										aria-invalid={ ariaInvalid(page.HasError(FieldStartTime)) }
										aria-describedby={ describedBy(FieldStartTime, false, page.HasError(FieldStartTime)) }
										required
									/>
								}
								@field(page, FieldResource, "Ressources", false, "Si la prestation a des besoins configurés, l’application choisit automatiquement un ensemble libre. Sinon, sélectionnez tout ce que l’intervention immobilise.", true) {
									<div id={ FieldResource } class={ "grid gap-2 rounded-box border p-3 sm:grid-cols-2", templ.KV("border-error", page.HasError(FieldResource)), templ.KV("border-base-300", !page.HasError(FieldResource)) } role="group" aria-invalid={ ariaInvalid(page.HasError(FieldResource)) } aria-describedby={ describedBy(FieldResource, true, page.HasError(FieldResource)) }>
										for _, option := range page.Resources {
											<label class="label min-h-11 cursor-pointer justify-start gap-3 rounded-btn px-2 hover:bg-base-200">
												<input type="checkbox" name={ FieldResource } value={ option.Value } class="checkbox checkbox-sm" checked?={ page.Values.ResourceSelected(option.Value) }/>
												<span class="label-text">{ option.Label }</span>
											</label>
										}
									</div>
								}
							</div>
							if page.IsNew() {
								<button
									type="submit"
									formaction="/agenda/availability"
									formmethod="post"
									class="btn min-h-11 w-full sm:w-auto"
								>
									Rechercher les créneaux libres
								</button>
							}
							if page.AvailabilitySearched {
								<div class="grid gap-2" aria-live="polite">
									<h3 class="text-sm font-semibold">Créneaux disponibles</h3>
									if page.AutomaticallyAllocated {
										<p class="text-sm opacity-70">Le technicien, le pont et les équipements requis seront attribués automatiquement à l’enregistrement.</p>
									}
									if !page.ScheduleConfigured {
										<p class="text-sm opacity-70">Configurez d’abord les horaires d’ouverture de ce site.</p>
									} else if !page.OpenThisDay {
										<p class="text-sm opacity-70">L’atelier est fermé ce jour-là.</p>
									} else if len(page.AvailableSlots) == 0 {
										<p class="text-sm opacity-70">Aucun créneau libre pour cet ensemble de ressources.</p>
									} else {
										<div class="flex flex-wrap gap-2">
											for _, slot := range page.AvailableSlots {
												<label class="btn btn-sm min-h-11 cursor-pointer">
													<input type="radio" name={ FieldStartTime } value={ slot.Value } class="sr-only" checked?={ page.Values.StartTime == slot.Value }/>
													{ slot.Label }
												</label>
											}
										</div>
									}
								</div>
							}
						</div>
					</section>
					<section class="card card-border border-base-300 bg-base-100">
						<div class="card-body gap-4 p-5">
							<h2 class="text-base font-semibold">Note</h2>
							@field(page, FieldNote, "Ce que le client a demandé", false, "Visible par l'atelier, pas par le client.", true) {
								<textarea
									id={ FieldNote }
									name={ FieldNote }
									class="textarea min-h-24 w-full"
									rows="3"
									aria-describedby={ describedBy(FieldNote, true, false) }
								>{ page.Values.Note }</textarea>
							}
						</div>
					</section>
					<div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center sm:justify-between">
						<a href={ templ.URL(agendaPath(page)) } class="btn btn-ghost min-h-11 sm:w-auto">Annuler</a>
						<button type="submit" class="btn btn-primary min-h-11 sm:w-auto" data-pending-label="Enregistrement…">
							if page.IsNew() {
								Prendre le rendez-vous
							} else {
								Enregistrer les modifications
							}
						</button>
					</div>
				</form>
				if !page.IsNew() && page.Cancellable {
					<section class="card card-border border-error/40 bg-base-100" aria-labelledby="cancel-heading">
						<div class="card-body gap-3 p-5">
							<h2 id="cancel-heading" class="text-base font-semibold">Annuler ce rendez-vous</h2>
							<p class="text-sm opacity-70">
								Le créneau est libéré et le rendez-vous reste dans l'historique du
								client. Rien n'est supprimé.
							</p>
							<form method="post" action={ templ.URL(cancelPath(page)) } data-pending-form>
								<button type="submit" class="btn btn-error btn-outline min-h-11 w-full sm:w-auto" data-pending-label="Annulation…">
									Annuler le rendez-vous
								</button>
							</form>
						</div>
					</section>
				}
			}
		</div>
		@pendingHandle.Once() {
			@pendingScript()
		}
	}
}

// field wraps one control with its label, its required marker, its hint and
// its inline error. The ids match what describedBy builds.
templ field(page FormPage, key string, label string, required bool, hint string, wide bool) {
	<div class={ "grid content-start gap-1", templ.KV("sm:col-span-2", wide) }>
		<label class="label flex-wrap justify-start gap-2 font-medium text-base-content" for={ key }>
			{ label }
			if required {
				<span class="text-xs font-normal opacity-60">Requis</span>
			} else {
				<span class="text-xs font-normal opacity-60">Optionnel</span>
			}
		</label>
		{ children... }
		if hint != "" {
			<p id={ key + "-hint" } class="label text-xs leading-snug whitespace-normal">{ hint }</p>
		}
		if page.HasError(key) {
			<p id={ key + "-error" } role="alert" class="label text-xs leading-snug font-medium whitespace-normal text-error">
				{ page.Error(key) }
			</p>
		}
	</div>
}

// notice reports a server-side outcome. An icon and a heading carry the
// meaning, so no state depends on colour alone.
templ notice(n Notice) {
	if !n.Empty() {
		<div role="alert" class={ "alert items-start text-left", noticeColor(n.Kind) }>
			if n.Kind == NoticeSuccess {
				@successIcon()
			} else {
				@warningIcon()
			}
			<div class="grid gap-1">
				<span class="font-semibold">{ noticeTitle(n.Kind) }</span>
				<span class="text-sm">{ n.Message }</span>
			</div>
		</div>
	}
}

templ warningIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"></path>
	</svg>
}

templ successIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
	</svg>
}

templ pendingScript() {
	<script>
		document.querySelectorAll("[data-pending-form]").forEach(function (form) {
			form.addEventListener("submit", function () {
				var button = form.querySelector("[data-pending-label]");
				if (!button) {
					return;
				}
				button.disabled = true;
				button.innerHTML =
					'<span class="loading loading-spinner loading-sm"></span>' +
					button.dataset.pendingLabel;
			});
		});
	</script>
}
