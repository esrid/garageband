package auth

import "github.com/esrid/garageband/internal/ui"

// Interface copy is French; identifiers and comments stay English.

// InvitationPage is the only screen an invited employee sees before working.
// It exists so that following the link is a deliberate act: messengers fetch
// pasted URLs to build previews, and a single-use invitation consumed by a
// preview bot would leave the employee locked out with no way to ask for
// another one.
templ InvitationPage(invitation Invitation, token string) {
	@ui.Layout(ui.PageInfo{Title: "Rejoindre l'équipe", NoIndex: true}) {
		<div class="card card-border mx-auto max-w-sm border-base-300 bg-base-100">
			<div class="card-body gap-4">
				<h1 class="card-title text-xl">Bonjour { invitation.Name }</h1>
				<p class="text-sm opacity-70">
					{ invitation.Organization } vous ouvre l'accès à son garage. Aucun mot de
					passe, aucune adresse e-mail : cet appareil vous connectera.
				</p>
				<form method="post" action={ templ.URL("/rejoindre/" + token) }>
					<button type="submit" class="btn btn-primary btn-block min-h-11">
						Rejoindre { invitation.Organization }
					</button>
				</form>
				<p class="text-xs opacity-60">
					Ce lien ne fonctionne qu'une fois. Gardez cet appareil pour vous
					reconnecter ; en cas de perte, demandez un nouveau lien.
				</p>
			</div>
		</div>
	}
}

// InvitationCodePage is the way in on a machine nobody can hand a link to —
// the reception PC, a second workshop screen. The employee types the code the
// owner reads out instead of transcribing a URL.
templ InvitationCodePage(failed bool) {
	@ui.Layout(ui.PageInfo{Title: "Entrer avec un code", NoIndex: true}) {
		<div class="card card-border mx-auto max-w-sm border-base-300 bg-base-100">
			<div class="card-body gap-4">
				<h1 class="card-title text-xl">Entrer avec un code</h1>
				if failed {
					<div role="alert" class="alert alert-warning items-start text-left">
						<span class="text-sm">
							Ce code ne fonctionne pas. Il a peut-être déjà servi ou expiré :
							demandez-en un nouveau à votre responsable.
						</span>
					</div>
				}
				<p class="text-sm opacity-70">
					Votre responsable vous donne un code à douze lettres et chiffres.
					Les tirets et les majuscules n'ont pas d'importance.
				</p>
				<form method="post" action="/rejoindre" class="grid gap-3">
					<label class="floating-label">
						<span>Votre code</span>
						<input
							type="text"
							name="code"
							class="input input-bordered w-full text-center font-mono text-lg tracking-widest uppercase"
							placeholder="XXXX-XXXX-XXXX"
							autocomplete="off"
							autocapitalize="characters"
							spellcheck="false"
							required
							autofocus
						/>
					</label>
					<button type="submit" class="btn btn-primary btn-block min-h-11">Continuer</button>
				</form>
			</div>
		</div>
	}
}

// InvitationExpiredPage covers every dead end the same way: consumed, expired,
// or never valid. It deliberately says nothing about which, and points at the
// only person who can fix it.
templ InvitationExpiredPage() {
	@ui.Layout(ui.PageInfo{Title: "Lien expiré", NoIndex: true}) {
		<div class="card card-border mx-auto max-w-sm border-base-300 bg-base-100">
			<div class="card-body gap-4">
				<h1 class="card-title text-xl">Ce lien n'est plus valable</h1>
				<p class="text-sm opacity-70">
					Il a déjà servi, ou il a expiré. Demandez à votre responsable de vous
					en générer un nouveau depuis l'écran Équipe.
				</p>
			</div>
		</div>
	}
}

templ LoginPage(providers []string) {
	@ui.Layout(ui.PageInfo{Title: "Connexion", NoIndex: true}) {
		<div class="card card-border mx-auto max-w-sm border-base-300 bg-base-100">
			<div class="card-body gap-4">
				<h1 class="card-title text-xl">Connexion</h1>
				if len(providers) == 0 {
					<div role="alert" class="alert alert-warning items-start text-left">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path>
						</svg>
						<div class="grid gap-1">
							<span class="font-semibold">Aucun fournisseur OAuth configuré</span>
							<span class="text-sm">
								Définissez <code class="kbd kbd-sm">GOOGLE_CLIENT_ID</code>/<code class="kbd kbd-sm">GOOGLE_CLIENT_SECRET</code>
								ou <code class="kbd kbd-sm">GITHUB_CLIENT_ID</code>/<code class="kbd kbd-sm">GITHUB_CLIENT_SECRET</code>,
								puis redémarrez.
							</span>
						</div>
					</div>
				} else {
					<ul class="grid gap-2">
						for _, name := range providers {
							<li>
								<a class="btn btn-block" href={ templ.URL("/auth/" + name) }>Continuer avec { name }</a>
							</li>
						}
					</ul>
				}
			</div>
		</div>
	}
}
